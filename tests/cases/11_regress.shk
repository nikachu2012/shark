// 直した不具合が戻っていないかを見る
import std.task;
import std.json;
import std.text;
import std.time;
import std.math;

var g: list<int> = [1, 2, 3];
var grid: list<list<int>> = [[1]];

func grow() -> int {
  for var i in range(2000) { g.push(i); }
  return 99;
}
func grow_grid() -> int {
  for var i in range(2000) { grid.push([0]); }
  return 42;
}
func boom() -> int {
  task.yield();
  panic("このタスクだけが止まる");
  return 1;
}

func main() -> int {
  // 代入先は右辺を作ってから決める（途中で配列が伸びても大丈夫）
  g[0] = grow();
  print(g[0]);
  grid[0].push(grow_grid());
  print(grid[0]);

  // += も同じ
  var xs = [10, 20];
  xs[0] += 5;
  print(xs);
  var s = ["a"];
  s[0] += "b";
  print(s[0]);

  // 引き算の左右が入れ替わらないこと
  var ys = [10];
  ys[0] -= 3;
  print(ys[0]);

  // 書式のあふれ
  print(f"{1e30:.2f}");
  print(f"{1.5:.60f}");

  // JSON のサロゲート対と、壊れた入力
  var emoji = json.parse("{\"k\":\"\\ud83d\\ude00\"}");
  print(emoji.value()["k"].string() ?? "×");
  print(json.parse("\"\\uZZZZ\"").ok());

  // 長い文字列でも正規表現が積み上がらない
  var long = "";
  for var i in range(20000) { long = long + "a"; }
  print(text.regex("a*b")!.matches(long));
  print(text.regex("a*b")!.matches(long + "b"));

  // 作ったばかりの値に、そのままメソッドを呼べる（仮想表の位置と取り違えない）
  print(Error("むり").message());
  print(Error("むり", 404).code());
  print(Error("むり").code());

  // float の見た目。桁が少なくても指数の形にしない
  print(60.0);
  print(100.0);
  print(1024.0);
  print(0.1);
  print(1e16);

  // 小さすぎ・大きすぎる数も、0 や inf に落とさずに読む
  print(2.2250738585072014e-308 > 0.0);
  print(1.7976931348623157e308 < math.INF);

  // 表示の切り替えは、指している瞬間を動かさない
  var t = time.datetime(2026, 8, 15, 12, 0, 0)!;
  print(t.to_local().to_utc().format("hh:mm"));
  print(t.to_local().to_local().format("hh:mm") == t.to_local().format("hh:mm"));
  print((t.to_local() - t).seconds());
  print(t.to_local().compare(t));

  // 待たれていないタスクが panic しても、プログラムは終わる
  _ = task boom();
  print("おわり");
  return 0;
}
