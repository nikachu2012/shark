// 標準ライブラリ（math / time / fmt / path / json / text）
import std.math;
import std.time;
import std.fmt;
import std.path;
import std.json;
import std.text;

func main() -> int {
  print(math.abs(-3));
  print(math.abs(-3.5));
  print(math.min(2, 3));
  print(math.max(1.5, 2.5));
  print(math.clamp(120, 0, 100));
  print(math.sqrt(2.0));
  print(math.floor(-1.5));
  print(math.ceil(-1.5));
  print(math.round(2.5));
  print(math.trunc(-1.5));
  print(math.is_nan(0.0));
  math.seed(42);
  var d = math.random_int(1, 6);
  print(d >= 1 && d <= 6);

  var t = time.date(2026, 8, 15)!;
  print(t.format("YYYY/MM/DD"));
  print(t.weekday());
  print((t + time.days(1.0)).format("YYYY-MM-DD"));
  print((t - time.date(2026, 8, 1)!).days());
  print(time.parse("2026-08-15 12:34:56", "YYYY-MM-DD hh:mm:ss")!.format("hh:mm"));

  print(fmt.bytes(1536));
  print(fmt.duration(time.seconds(3725.0)));
  print(fmt.truncate("とても長い名前です", 8));
  print(fmt.apply(3.14159, ".3f"));

  // 区切り文字は環境に合わせて変わる（Windows は \）。見比べられるよう / にそろえる
  print(path.join("data", "fish.json").replace(path.separator(), "/"));
  print(path.dir("data/fish.json"));
  print(path.name("data/fish.json"));
  print(path.stem("data/fish.json"));
  print(path.ext("data/fish.json"));
  print(path.normalize("a/b/../c").replace(path.separator(), "/"));

  var j = try_parse("{\"items\":[{\"name\":\"さめ\",\"size\":400}]}");
  print(j["items"][0]["name"].string() ?? "×");
  print(j["items"][0]["size"].int() ?? 0);
  print(j["none"]["deep"].exists());
  print(json.stringify(json.of({"a": json.of(1)})));

  print(text.width("さめ"));
  print(text.normalize("が", "NFD").len());
  print(text.code("A"));
  print(text.from_code(12354) ?? "");
  print(text.is_digit("123"));
  var names = ["サメ", "あじ", "ぶり", "いわし"];
  text.sort_ja(ref names);
  print(names);
  var re = text.regex("([0-9]{4})-([0-9]{2})")!;
  if var m = re.find("期限は 2026-08 です") {
    print(m.text());
    print(m.group(1) ?? "");
    print(m.start());
  }
  print(re.replace("2026-08", "$1年$2月"));
  return 0;
}

func try_parse(s: string) -> Json {
  var r = json.parse(s);
  if r.ok() { return r.value(); }
  return json.none();
}
