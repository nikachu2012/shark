// 書式指定（f"..."）
func main() -> int {
  var n = 42;
  var pi = 3.14159;
  var name = "さめ";
  print(f"{n:5}|");
  print(f"{n:<5}|");
  print(f"{n:^7}|");
  print(f"{n:05}");
  print(f"{n:x}");
  print(f"{n:X}");
  print(f"{n:b}");
  print(f"{n:o}");
  print(f"{1234567:,}");
  print(f"{pi:.2f}");
  print(f"{pi:10.3f}|");
  print(f"{0.125:.1%}");
  print(f"{name:*<10}|");
  print(f"{name:*>10}|");
  print(f"{name:*^10}|");
  print(f"{{ かっこ }}");
  print(f"{n} と {name} と {pi}");
  return 0;
}
