// クラス・継承・virtual・インタフェース・Comparable
class Fish {
  public var name: string;
  public var size: int;
  func init(name: string, size: int) {
    this.name = name;
    this.size = size;
  }
  func init(name: string) { this.init(name, 0); }
  public func describe() -> string { return f"{this.name} ({this.size}cm)"; }
  public virtual func label() -> string { return this.name; }
  public func to_string() -> string { return this.name; }
}

class Swimmer {
  public virtual func speed() -> float;
}

class Shark : Fish, Swimmer {
  var teeth: int;
  func init(name: string, teeth: int) {
    super.init(name, 400);
    this.teeth = teeth;
  }
  override func label() -> string { return f"🦈 {super.label()}"; }
  override func speed() -> float { return 8.0; }
}

class Dolphin : Fish, Swimmer {
  func init() { super.init("いるか", 200); }
  override func speed() -> float { return 12.0; }
}

class Sized : Comparable {
  public var v: int;
  func init(v: int) { this.v = v; }
  override func compare(other: Sized) -> int {
    if this.v < other.v { return -1; }
    if this.v > other.v { return 1; }
    return 0;
  }
  public func to_string() -> string { return string(this.v); }
}

func race(a: Swimmer, b: Swimmer) -> string {
  if a.speed() > b.speed() { return "先"; }
  return "後";
}

func main() -> int {
  var f = Fish("さめ", 400);
  print(f.describe());
  print(Fish("ふぐ").describe());

  var s: Fish = Shark("しゃち", 50);
  print(s.label());
  print(f.label());

  print(race(Shark("さめ", 1), Dolphin()));

  var xs = [Sized(3), Sized(1), Sized(2)];
  xs.sort();
  print(xs);

  var ys = ["さめ", "あじ", "ぶり"];
  ys.sort();
  print(ys);

  print(f == Fish("さめ", 400));
  print(f == Fish("ふぐ", 400));
  return 0;
}
