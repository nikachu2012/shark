// print / write はどんな型でも受け取る。クラスは to_string() があれば自動で呼ぶ

class Show {
  public virtual func to_string() -> string;
}

class Fish : Show {
  public var name: string;
  public var size: int;
  func init(name: string, size: int) { this.name = name; this.size = size; }
  public override func to_string() -> string { return f"{this.name}({this.size}cm)"; }
}

class Shark : Fish {
  func init() { super.init("さめ", 400); }
  public override func to_string() -> string { return f"🦈 {super.to_string()}"; }
}

// to_string() を持たないクラス
class Rock {
  public var w: int;
  var tag: string;
  func init(w: int) { this.w = w; this.tag = "石"; }
}

// 親の to_string() をそのまま使う
class Tuna : Fish {
  func init() { super.init("まぐろ", 200); }
}

func shown<T: Show>(v: T) -> void { print(v); }
func anything<T>(v: T) -> void { print(v); }

func main() -> int {
  // to_string() がある / 無い
  print(Fish("ふぐ", 20));
  print(Rock(3));
  print(Tuna());

  // virtual は実際の型のものが呼ばれる
  var f: Fish = Shark();
  print(f);

  // 制約つきの型引数なら呼ばれる。制約が無ければそのまま出る
  shown(Fish("あじ", 30));
  anything(Fish("さば", 40));
  anything(7);

  // ほかの型もそのまま渡せる
  var m: int? = none;
  print(m);
  var m2: string? = "ある";
  print(m2);

  // T? は、値があれば to_string()、無ければ none
  var o1: Fish? = Fish("さんま", 25);
  print(o1);
  var o2: Fish? = none;
  print(o2);
  var o3: Rock? = Rock(5);
  print(o3);
  print(range(0, 3));
  print([1, 2, 3]);
  print({"a": 1});
  print(b"AB");
  print(3.5);
  print(true);

  // 入れ子のクラスは、既定の出し方になる
  print([Fish("いわし", 10)]);

  // write も同じ
  write(Fish("たい", 50));
  write(" / ");
  write(Rock(9));
  print("");
  return 0;
}
