// 基本の型・演算・文
func main() -> int {
  var n = 10;
  var pi = 3.5;
  var flag = true;
  var name = "さめ";
  print(n + 2);
  print(n / 3);      // 整数の除算は 0 方向へ切り捨て
  print(-7 / 2);
  print(-7 % 2);     // 剰余の符号は割られる数に従う
  print(7 % -2);
  print(pi * 2.0);
  print(!flag);
  print(name + "です");
  print(n > 3 && n < 20);
  print(n == 10 || flag);

  var i = 0;
  var total = 0;
  while i < 5 {
    i += 1;
    if i == 2 { continue; }
    if i == 4 { break; }
    total += i;
  }
  print(total);

  for var k in range(3) { write(string(k)); }
  print("");
  for var k in range(1, 4) { write(string(k)); }
  print("");
  for var k in range_step(10, 0, -2) { write(string(k)); }
  print("");
  return 0;
}
