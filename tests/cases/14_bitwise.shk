// ビット演算と冪乗（spec/syntax.md）。動きは C と同じ

func main() -> int {
  // 基本の4つ
  print(12 & 10);
  print(12 | 10);
  print(12 ^ 10);
  print(~12);

  // ずらす。右へは符号を保ったままずらす（算術シフト）
  print(1 << 10);
  print(-16 >> 2);
  print(16 >> 2);
  print(1 << 63);          // 桁があふれても止めない。ビットの並びとして扱う
  print(-1 >> 63);

  // 強さの順は C と同じ（& は == より弱く、<< は + より弱い）
  print(12 | 10 ^ 6 & 3);
  print(12 + 10 << 2);
  print(12 << 2 + 1);
  print((12 & 10) == 8);

  // 書き換えながら使う
  var x = 1;
  x <<= 4;
  x |= 3;
  x &= 6;
  x ^= 7;
  x >>= 1;
  print(x);

  // 入れ子の型は >> と間違えない
  var grid: list<list<int>> = [[1, 2], [3]];
  print(grid[0][1] << 1);

  // 冪乗。右結合で、単項より強い
  print(2 ** 10);
  print(2 ** 3 ** 2);
  print(-2 ** 2);
  print(0 ** 0);
  print(2.0 ** 0.5);
  print(2.0 ** -1.0);

  // ビットを見せる書き方
  print(f"{5 << 2:b}");
  print(f"{255 & 0x0f:x}");
  return 0;
}
