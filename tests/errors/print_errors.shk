// print に渡せないもの

class Priv {
  var n: int;
  func init(n: int) { this.n = n; }
  // public が無いので、外からは呼べない
  func to_string() -> string { return f"priv({this.n})"; }
}

func nothing() -> void { }

func main() -> int {
  print(nothing());       // 値がない
  print(Priv(1));         // to_string() が見えない
  print(1, nothing());    // 2つ目に値がない
  print(1, sepp: "-");    // 使えない名前
  print(1, sep: 2);       // sep は string
  return 0;
}
