// 並行処理の例（spec/runtime/concurrency.md）
func fetch(name: string, sec: float) -> string {
  sleep(sec);                 // カレントタスクのみスリープ
  return name + " 取得";
}

func worker(ch: channel<string>, name: string) -> void {
  sleep(0.01);
  _ = ch.send(name);
}

func main() -> int {
  var t = task fetch("A", 0.05);   // バックグラウンドで非同期実行開始
  print("ほかのことをする");
  print(t.wait());

  var pages = parallel {           // 複数タスクを並行実行し、すべて完了するまで待機
    task fetch("B", 0.03);
    task fetch("C", 0.02);
  };
  print(pages);

  var ch = channel<string>();      // チャンネル（マルチプロデューサー・シングルコンシューマー）
  task worker(ch, "い");
  task worker(ch, "ろ");
  for var i in range(2) {
    print(ch.recv() ?? "なし");
  }
  return 0;
}
