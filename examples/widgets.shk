// widgets.shk — 宣言的 UI ウィジェットの総合デモ
//
//   ./shark run examples/widgets.shk
//
// 登場するウィジェット:
//   ui.label / ui.button / ui.checkbox / ui.radio / ui.slider / ui.number /
//   ui.drag / ui.field / ui.password / ui.textarea / ui.combo / ui.listbox /
//   ui.tabs / ui.color / ui.tree / ui.image / ui.space / ui.spacer /
//   ui.divider / ui.col / ui.row / ui.grid / ui.center / ui.stack / ui.scroll
// 「消す」ボタンをクリックするとモーダルダイアログが表示されます。ui.stack は最前面の
// ウィジェットがイベントを優先して捕捉するため、半透明オーバーレイを重ねるだけで背面の操作を遮断できます。
// メソッドチェーンによるスタイル指定:
//   .color / .background / .border / .radius / .padding / .width / .height /
//   .align / .valign / .filter / .decimals / .tooltip / .placeholder /
//   .font / .disabled（この2つは子ウィジェットにも継承されます）
//
// リストボックス（ui.listbox）、コンボボックス（ui.combo）、テキストエリア（ui.textarea）は、
// マウスホイールによるスクロールに対応しています。リストボックスのスクロールバーはドラッグ操作も可能です。
//
// **キーボードによるアクセシビリティ操作にも対応しています。** Tab キーで次のウィジェットへ
// （Shift+Tab で前へ）フォーカスを移動し、Space または Enter キーで決定/トグルできます。
// スライダーやタブは左右キー、リストボックスや数値入力は上下キーで操作可能です。
//
// 状態管理は通常の変数を **ref で渡す** だけです。値が変更されると変数が直接更新されるため、
// ウィジェット ID や update()、ui.value() による手動取得は不要です。
// アプリケーション状態はユーザー側で管理し、ランタイムは対象変数のスロット参照を追跡します。
//
// ID を付与して update(hit) でイベントを振り分ける旧来の形式にも対応しています（下記のグリッドなど、
// 動的に生成する要素でクロージャが使用できない場合は ID 方式でイベントを受け取ります）。
//
// 日本語フォントは ui.run() が OS のシステムフォントを自動読み込みして描画します。
// Web（Wasm）環境ではブラウザのネイティブテキスト描画により IME かな漢字変換もそのまま利用可能です。
import std.ui;
import std.file;

// 状態はふつうの変数。処理系は覚えない。
// 入力欄に ref で渡すものは、ここ（一番外側）に置く
var count = 0;
var sound = true;
var volume = 60;
var size = 1;
var age = 12;
var name = "さめ";
var word = "aiueo";
var memo = "ここは複数行の入力欄です。\n改行は enter。\n上下の矢印で行を行き来し、置ける幅に入らない行はひとりでに折り返します。";
var page = 0;
var kuwashiku = false;   // 「くわしい設定」を使えるようにするか（.disabled）
var toi = false;         // モーダルダイアログの表示フラグ
var iro = 4;
var sakana = 0;
var last = "なし";
var fine = 0.35;                       // 小数のつまみ・引いて変える欄
var seen = false;                      // あいことばを見せるか
var hex = "1F";                        // 16 進しか入らない欄
var sumi = ui.rgb(232, 92, 92);        // 色の入力
var open_ki = true;                    // 木を開いているか
var erabu: list<int> = [0, 4];         // いくつも選べる一覧

var iro_na = ["あか", "だいだい", "きいろ", "みどり", "あお", "むらさき"];
var iro_ne = [ui.rgb(232, 92, 92), ui.rgb(232, 168, 76), ui.rgb(224, 216, 96),
              ui.rgb(108, 204, 128), ui.rgb(76, 155, 232), ui.rgb(176, 128, 232)];
var sakana_na = ["さめ", "しゃち", "いるか", "くじら", "まぐろ", "まんぼう",
                 "たい", "ひらめ", "うなぎ", "さんま", "あじ", "ふぐ"];

// ui.image に渡す絵。選んだ色で、まるを1つ描くだけ
func swatch() -> Canvas {
  var e = ui.canvas(40, 24, ui.rgb(24, 24, 34));
  e.fill_circle(20, 12, 9, iro_ne[iro]);
  return e;
}

// セル生成関数から作るグリッド（ui.grid(行, 列, cell)）。
// クロージャでの変数キャプチャを行わないため、ここは ID 方式でイベントを受け取る
func cell(r: int, c: int) -> Widget {
  var i = r * 3 + c;
  return ui.button(iro_na[i], f"c{i}").background(iro_ne[i]).width(1.0)
      .tooltip(f"{iro_na[i]} にします");
}

// スクロールコンテナに配置する子要素。要素数が多く表示領域を超えるためスクロールして表示する
func scroll_kids() -> list<Widget> {
  var kids: list<Widget> = [];
  for var i in range(sakana_na.len()) {
    kids.push(ui.label(f"{i + 1}. {sakana_na[i]}"));
  }
  return kids;
}

func onoff(on: bool) -> string {
  if on { return "出す"; }
  return "出さない";
}

// タブで開いているものの中身。**見出し（ui.tabs）と中身は別々**なので、
// どれを出すかはここで決められる
func body() -> Widget {
  if page == 1 {
    return ui.col([
      ui.grid(2, 3, cell),
      ui.row([
        ui.label("えらんだの"),
        // 重ね置き（ui.stack）。下地の上に、字をまんなかで重ねる
        ui.stack([
          ui.label("").width(64).height(16).background(iro_ne[iro]).radius(4),
          ui.label(iro_na[iro]).width(64).height(16).align("center").valign("middle")
              .color(ui.rgb(20, 20, 28)),
        ]),
        ui.spacer(),                   // 数を省くと、余りをぜんぶ取る（右へ寄る）
        // 絵を出す部品。中身は下の swatch() が描く
        ui.image(swatch()).border(ui.rgb(70, 80, 100)),
      ]),
    ]);
  }
  if page == 2 {
    return ui.col([
      ui.listbox(ref sakana, sakana_na, 5),
      ui.label(f"えらんだの: {sakana_na[sakana]}"),
    ]);
  }
  if page == 3 {
    // いくつも選べる一覧（番号の並びを渡す）と、折りたためる木
    return ui.col([
      ui.listbox(ref erabu, sakana_na, 4),
      ui.label(f"{erabu.len()} ひき えらんだ"),
      ui.tree("しらべる", ref open_ki, [
        ui.label("木の中には、どんな部品でも入れられる"),
        // スクロールコンテナ。高さを指定し、超過分をスクロールして表示する
        ui.scroll(scroll_kids()).height(60).border(ui.rgb(70, 80, 100)).radius(4),
      ]),
    ]);
  }
  return ui.col([
    ui.textarea(ref memo, 5).placeholder("ここに おもったことを 書きます").width(float.infinity()),
    ui.label(f"{memo.len()} 文字").align("right"),
  ]);
}

// いまどうあるべきか。部品を組んで、1つ返すだけ。
// 名前と中身は **ui.grid(2, ...) の表**に並べる。列の幅はその列でいちばん広い升に
// 揃うので、名前を右に寄せておくと、中身の左端が1本にそろう
func name_of(s: string) -> Widget {
  return ui.label(s).align("right");
}

// いまの画面。前に出すものが無ければ、これがそのまま出る
func screen() -> Widget {
  var lines = memo.split("\n").len();
  return ui.col([
    // 見出し。ui.center は「置ける幅の真ん中に置く」。
    // .font は字だけでなく、余白も間も釣り合ったまま大きくする
    ui.center([ui.label("ウィジェットカタログ").font(20).color(ui.rgb(120, 200, 255))]),
    ui.divider(),

    ui.row([
      // ---------------------------------------------------------- 左がわ
      ui.col([
        ui.row([
          // ボタンは値を持たないので、動きをその場に書く
          ui.button("ふやす", func() -> void { count += 1; }),
          ui.button("へらす", func() -> void { count -= 1; }),
          ui.spacer(20),               // 並んでいる向き（ここは横）に 20 画素あける
          ui.button("もどす", func() -> void { count = 0; }).tooltip("0 にもどします"),
        ]),
        ui.space(4),

        // 名前と中身の表。升は左上から右へ、2つずつ詰まる
        ui.grid(2, [
          name_of("おした数"), ui.label(f"{count} 回"),

          name_of("音"), ui.checkbox("出す", ref sound),

          name_of("おおきさ"), ui.row([
            ui.slider(ref volume, 0, 100),
            ui.label(f"{volume}").width(28).align("right"),
          ]),

          // 0 から 120 の外には出られない。− と ＋ でも動かせる
          name_of("とし"), ui.number(ref age, 0, 120)
              .tooltip("0 から 120 まで。打っても外には出ません"),

          name_of("大きさ"), ui.row([
            // 同じ変数を渡して、それぞれに「自分の数」を持たせる
            ui.radio("小", ref size, 0),
            ui.radio("中", ref size, 1),
            ui.radio("大", ref size, 2),
          ]),

          // つまみと同じ書き方で、小数もそのまま渡せる
          name_of("こまかさ"), ui.row([
            ui.slider(ref fine, 0.0, 1.0),
            ui.drag(ref fine, 0.0, 1.0).decimals(2)
                .tooltip("押したまま横に引くと変わります。動かさずに離すと打てます"),
          ]),

          name_of("すきないろ"), ui.combo(ref iro, iro_na),

          // 押すと、色を選ぶ板が下に出る
          name_of("すみの色"), ui.color(ref sumi),

          name_of("なまえ"), ui.field(ref name).placeholder("なまえ"),

          // 見せるかどうかも、ただの変数
          name_of("あいことば"), ui.row([
            ui.password(ref word, seen).placeholder("あいことば")
                .tooltip("打った字は * になります"),
            ui.checkbox("見せる", ref seen),
          ]),

          // 入れてよい字を決めておくと、それ以外は入らない
          name_of("16 進"), ui.field(ref hex).filter("hex").width(70)
              .tooltip("0〜9 と a〜f だけが入ります"),
        ]),

        ui.space(4),
        ui.label(f"こんにちは、{name} さん").color(ui.rgb(150, 220, 150)),
        ui.space(4),

        // .disabled は入れ物に書くと、中のものがまとめて止まる。
        // うすくなって、押しても引いても打っても動かない。場所は同じだけ取るので、
        // 出し入れしても画面が動かない
        ui.checkbox("くわしい設定を出す", ref kuwashiku),
        ui.row([
          ui.label("小さい字").font(9),
          ui.button("ためす", "kuwashiku").font(9),
        ]).disabled(!kuwashiku),
      ]).width(1.0),

      // ---------------------------------------------------------- 右がわ
      ui.col([
        // 見出しだけを出して、中身は body() が返す
        ui.tabs(ref page, ["メモ", "いろ", "さかな", "えらぶ"]),
        body().height(float.infinity()),     // 余ったところまで伸びる
        ui.divider(),

        // こちらも同じ表
        ui.grid(2, [
          name_of("音"), ui.label(onoff(sound)),
          name_of("おおきさ"), ui.label(f"{volume}"),
          name_of("とし"), ui.label(f"{age}"),
          name_of("メモ"), ui.label(f"{lines} 行"),
        ]),
      ]).width(1.0),
    ]),

    ui.divider(),
    ui.row([
      ui.label(f"さいごに動いたもの: {last}").padding(2)
          .background(ui.rgb(30, 30, 40)).width(float.infinity()),
      ui.button("消す", func() -> void { toi = true; }),
      ui.button("おわる", func() -> void { ui.quit(); }),
    ]),
  ]);
}

// モーダルダイアログの表示。
//
// 重ね合わせ（ui.stack）では、クリック等のヒットテストは最前面の要素が捕捉する。
// 画面全体を覆う半透明のオーバーレイを 1 枚挟むことで、背面ウィジェットへの入力をブロックできる。
// 特別なモーダルシステムを必要とせず、スタック配置のみで実現可能。
func view() -> Widget {
  if !toi { return screen(); }
  return ui.stack([
    screen(),
    // 半透明オーバーレイ。ここでクリックイベントを遮断し、背面への操作を防止
    ui.label("").width(float.infinity()).height(float.infinity())
        .background(ui.rgba(0, 0, 0, 150)),
    ui.col([
      ui.label("メモを消しますか？").font(14),
      ui.space(6),
      ui.row([
        ui.button("やめる", func() -> void { toi = false; }),
        ui.button("消す", func() -> void { memo = ""; toi = false; }),
      ]).align("right"),
    ]).padding(10).background(ui.rgb(38, 40, 52))
        .border(ui.rgb(90, 100, 130)).radius(6)
        .align("center").valign("middle"),
  ]);
}

// ID が付与されたウィジェットが操作されたとき。ここに来るのは、上のグリッドセル（動的に生成するもの）のみ
func update(hit: string) -> void {
  if hit != "" { last = hit; }
  for var i in range(iro_ne.len()) {
    if hit == f"c{i}" { iro = i; }
  }
}

func main() -> int {
  ui.theme(ui.rgb(18, 18, 26), ui.rgb(232, 232, 236), ui.rgb(76, 155, 232));

  ui.run("ウィジェットカタログ", 700, 540, view, update);

  // 画面が無いときは、ui.run が1回だけ描いて返り、面はそのまま残る
  if ui.width() > 0 {
    _ = file.write_bytes("widgets.png", ui.to_png());
    print("画面がないので widgets.png に保存しました");
    ui.close();
    return 0;
  }
  print(f"{count} 回おしました");
  return 0;
}
