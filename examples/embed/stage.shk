// stage.shk — ステージ3のAIスクリプト。
// move / turn / at_goal はホスト（ゲームエンジン側）が公開した関数（examples/embed/game_hosts.h）。
//
// このファイルはビルド時に build_stage によってバイトコードへコンパイルされます。
// ターゲット機側にはバイトコードのみが組み込まれ、ソースファイルは含めません。
func main() -> int {
  var steps = 0;
  while !at_goal() {
    move("forward");
    steps += 1;
    if steps % 2 == 0 { turn("right"); }
    if steps > 20 {
      print("迷ってしまった\n");
      return 1;
    }
  }
  print(f"ゴール！ {steps} 歩でした\n");
  return 0;
}
