// counter.shk — 宣言的な書き方の例（spec/library/ui.md）
//
//   ./shark run examples/counter.shk
//
// くり返しも描き直しも ui.run() が引き受ける。書くのは「いまどうあるべきか」と、
// **押されたときの動き**だけ。動きは名前を付けず、部品を書いたその場に置ける。
// 入力欄は ref で変数を渡すと、打たれるたびにその変数が書き換わる。
//
// 日本語は ui.run() が機種のフォントを読むので、そのまま出る。
// FreeType を入れずに作ったときは □ になる（README の「日本語の字を出す」）。
import std.ui;
import std.file;

// 状態はふつうの変数。処理系は覚えない。
// 入力欄に ref で渡すものは、ここ（一番外側）に置く
var count = 0;
var sound = true;
var volume = 60;
var name = "さめ";

// いまどうあるべきか。押されたときの動きは、その場に書く
func view() -> list<Widget> {
  return [
    ui.center([ui.label("かうんた").color(ui.rgb(120, 200, 255))]),
    ui.divider(),
    ui.label(f"{count} 回おした"),
    ui.row([
      ui.button("ふやす", func() -> void { count += 1; }),
      ui.button("へらす", func() -> void { count -= 1; }),
      ui.button("もどす", func() -> void { count = 0; }),
    ]),
    ui.space(4),
    ui.checkbox("音を出す", func() -> void { sound = ui.value() == 1; }, sound),
    ui.row([
      ui.label("おおきさ"),
      ui.slider(func() -> void { volume = ui.value(); }, volume, 0, 100),
    ]),
    ui.label(f"{volume}"),
    ui.space(4),
    ui.label("なまえ（押してから打つ。右で押すと切り貼り）"),
    ui.field(ref name),              // 打たれるたびに name が書き換わる
    ui.label(f"こんにちは、{name} さん"),
    ui.space(4),
    ui.button("おわる", func() -> void { ui.quit(); }).align("right"),
  ];
}

func main() -> int {
  ui.theme(ui.rgb(18, 18, 26), ui.rgb(232, 232, 236), ui.rgb(76, 155, 232));

  ui.run("かうんた", 420, 360, view);

  // 画面が無いときは、ui.run が1回だけ描いて返り、面はそのまま残る
  if ui.width() > 0 {
    _ = file.write_bytes("counter.png", ui.to_png());
    print("画面がないので counter.png に保存しました");
    ui.close();
    return 0;
  }
  print(f"{count} 回おしました");
  return 0;
}
