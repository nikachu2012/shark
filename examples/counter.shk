// counter.shk — 宣言的 UI の実装例（spec/library/ui.md）
//
//   ./shark run examples/counter.shk
//
// イベントループと画面の再描画は ui.run() が自動管理します。開発者は「あるべき画面状態（view）」と、
// **イベント発生時のアクション** を記述するだけです。コールバック関数はインラインで無名関数として定義できます。
// 入力欄に ref で変数を渡すと、入力が行われるたびに変数の値が直接更新されます。
//
// 日本語テキストは ui.run() がシステムフォントを自動読み込みして描画します。
import std.ui;
import std.file;

// アプリケーション状態は通常の変数で管理。
// 入力欄に ref で渡す変数はトップレベル（グローバルスコープ）に配置する
var count = 0;
var sound = true;
var volume = 60;
var name = "さめ";

// 現在の画面ツリーを構築（ui.col でウィジェットを縦方向に配置して返す）。
// ボタン押下時のハンドラは無名関数としてインラインで記述
func view() -> Widget {
  return ui.col([
    ui.center([ui.label("かうんた").color(ui.rgb(120, 200, 255))]),
    ui.divider(),
    ui.label(f"{count} 回おした"),
    ui.row([
      ui.button("ふやす", func() -> void { count += 1; }),
      ui.button("へらす", func() -> void { count -= 1; }),
      ui.button("もどす", func() -> void { count = 0; }).height(float.infinity()),
    ]),
    ui.space(4),
    ui.checkbox("音を出す", func() -> void { sound = ui.value() == 1; }, sound),
    ui.row([
      ui.label("おおきさ"),
      ui.slider(func() -> void { volume = ui.value(); }, volume, 0, 100),
    ]),
    ui.label(f"{volume}"),
    ui.space(4),
    ui.label("なまえ（押してから打つ。右で押すと切り貼り）"),
    ui.field(ref name),              // 入力時に name が直接更新される
    ui.label(f"こんにちは、{name} さん"),
    ui.space(4),
    ui.button("おわる", func() -> void { ui.quit(); }).align("right"),
  ]);
}

func main() -> int {
  ui.theme(ui.rgb(18, 18, 26), ui.rgb(232, 232, 236), ui.rgb(76, 155, 232));

  ui.run("かうんた", 420, 360, view);

  // ヘッドレス環境では ui.run() が 1 フレーム描画して復帰する
  if ui.width() > 0 {
    _ = file.write_bytes("counter.png", ui.to_png());
    print("画面がないので counter.png に保存しました");
    ui.close();
    return 0;
  }
  print(f"{count} 回おしました");
  return 0;
}
