// ui.shk — ブラウザで std.ui を動かす例
//
// 実行を押すと**窓**が出る。押す・引く・打つ が、そのまま面に届く。
// 名札の帯を引けば動かせるし、右下の隅を引けば大きさが変わる（面も作り直される）。
//
// くり返しも描き直しも ui.run() が引き受ける。書くのは「いまどうあるべきか」（view）と、
// 押されたときの動きだけ（spec/library/ui.md、examples/counter.shk）。
//
// 字はブラウザに描いてもらうので、日本語もそのまま出る
// （どの機種にもある字を選んである → core/platform/font_canvas.inc）。
// 入力欄（ui.field）は、ブラウザのかな漢字変換がそのまま使える。
import std.ui;

// 状態はふつうの変数。処理系は覚えない
var count = 1;
var size = 20;
var name = "さめ";

// 数のぶんだけ魚を並べる
func fish(n: int) -> string {
  var s = "";
  var i = 0;
  while i < n {
    s += "><> ";
    i += 1;
  }
  return s;
}

// いまどうあるべきか。押されたときの動きは、その場に書く
func view() -> Widget {
  var n = count;
  if n < 0 { n = 0; }
  if n > 12 { n = 12; }
  return ui.col([
    ui.center([ui.label("ブラウザの中の Shark").color(ui.rgb(120, 200, 255))]),
    ui.divider(),
    ui.label(fish(n)),
    ui.label(f"{count} 回おした"),
    ui.row([
      ui.button("ふやす", func() -> void { count += 1; }),
      ui.button("へらす", func() -> void { count -= 1; }),
      ui.button("もどす", func() -> void { count = 0; }),
    ]),
    ui.space(4),
    ui.row([
      ui.label("おおきさ"),
      ui.slider(func() -> void { size = ui.value(); }, size, 6, 40),
      ui.label(f"{size}"),
    ]),
    ui.space(4),
    ui.label("なまえ（押してから打つ。変換もできる）"),
    ui.field(ref name),                  // 打たれるたびに name が書き換わる
    ui.label(f"こんにちは、{name} さん！"),
    ui.space(4),
    ui.label(f"字は {ui.font_name()}").color(ui.rgb(130, 140, 155)),
    ui.button("おわる", func() -> void { ui.quit(); }).align("right"),
  ]);
}

func main() -> int {
  ui.theme(ui.rgb(18, 18, 26), ui.rgb(232, 232, 236), ui.rgb(76, 155, 232));
  ui.run("さめの窓", 420, 380, view);
  print(f"{count} 回おしました（なまえ: {name}）");
  return 0;
}
