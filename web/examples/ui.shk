// ui.shk — ブラウザ環境での std.ui 実装例
//
// 実行すると仮想ウィンドウが表示され、クリック・ドラッグ・キー入力が描画サーフェスに反映されます。
// タイトルバーをドラッグしてウィンドウを移動、右下隅をドラッグしてリサイズ可能です（サーフェスも自動追従）。
//
// イベントループと画面の再描画は ui.run() が自動管理します。
// 記述するのは「あるべき画面状態（view）」とイベントハンドラのみです（spec/library/ui.md 参照）。
//
// テキスト描画はブラウザのネイティブ Canvas API を使用するため、日本語もそのまま表示されます。
// 入力欄（ui.field）では、ブラウザの IME によるかな漢字変換が利用可能です。
import std.ui;

// 状態はふつうの変数。処理系は覚えない
var count = 1;
var size = 20;
var name = "さめ";

// 数のぶんだけ魚を並べる
func fish(n: int) -> string {
  var s = "";
  var i = 0;
  while i < n {
    s += "><> ";
    i += 1;
  }
  return s;
}

// いまどうあるべきか。押されたときの動きは、その場に書く
func view() -> Widget {
  var n = count;
  if n < 0 { n = 0; }
  if n > 12 { n = 12; }
  return ui.col([
    ui.center([ui.label("ブラウザの中の Shark").color(ui.rgb(120, 200, 255))]),
    ui.divider(),
    ui.label(fish(n)),
    ui.label(f"{count} 回おした"),
    ui.row([
      ui.button("ふやす", func() -> void { count += 1; }),
      ui.button("へらす", func() -> void { count -= 1; }),
      ui.button("もどす", func() -> void { count = 0; }),
    ]),
    ui.space(4),
    ui.row([
      ui.label("おおきさ"),
      ui.slider(func() -> void { size = ui.value(); }, size, 6, 40),
      ui.label(f"{size}"),
    ]),
    ui.space(4),
    ui.label("なまえ（押してから打つ。変換もできる）"),
    ui.field(ref name),                  // 入力時に name が直接更新される
    ui.label(f"こんにちは、{name} さん！"),
    ui.space(4),
    ui.label(f"字は {ui.font_name()}").color(ui.rgb(130, 140, 155)),
    ui.button("おわる", func() -> void { ui.quit(); }).align("right"),
  ]);
}

func main() -> int {
  ui.theme(ui.rgb(18, 18, 26), ui.rgb(232, 232, 236), ui.rgb(76, 155, 232));
  ui.run("さめの窓", 420, 380, view);
  print(f"{count} 回おしました（なまえ: {name}）");
  return 0;
}
