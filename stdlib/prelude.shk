// prelude.shk — Shark 自身で実装された標準ライブラリ共通プレリュード
//
// ソート処理（マージソート）は基本型・クラス型を問わず同一コードで処理するため Shark 自身で実装
// （compare のディスパッチは VM が行う）。ランタイムバイナリにヘッダとして埋め込まれ、
// 起動時に読み込まれる。core/prelude.h は tools/prelude.py により本ファイルから自動生成される。
//
// 接頭辞 __ を持つ関数は内部用シンボル。ユーザーコードには直接露出せず、xs.sort() 等の内部実装から呼び出される。

func __merge<T: Comparable>(ref xs: list<T>, lo: int, mid: int, hi: int) -> void {
  var tmp: list<T> = [];
  var a = lo;
  var b = mid;
  while a < mid && b < hi {
    if xs[b].compare(xs[a]) < 0 {
      tmp.push(xs[b]);
      b = b + 1;
    } else {
      tmp.push(xs[a]);
      a = a + 1;
    }
  }
  while a < mid { tmp.push(xs[a]); a = a + 1; }
  while b < hi { tmp.push(xs[b]); b = b + 1; }
  var k = 0;
  while k < tmp.len() {
    xs[lo + k] = tmp[k];
    k = k + 1;
  }
}

func __sort<T: Comparable>(ref xs: list<T>) -> void {
  var n = xs.len();
  if n < 2 { return; }
  var width = 1;
  while width < n {
    var i = 0;
    while i < n {
      var mid = i + width;
      var hi = i + width + width;
      if mid > n { mid = n; }
      if hi > n { hi = n; }
      __merge(ref xs, i, mid, hi);
      i = i + width + width;
    }
    width = width + width;
  }
}

// ui.action() のデフォルト戻り値。アクション関数が未設定のウィジェット用
func __noop() -> void {
}
