// prelude_ui.shk — 宣言的に書くときの入り口。Shark 自身で書いてある。
//
// ui.run() が、開く・くり返す・描き直す・閉じる をぜんぶ引き受ける。
// 書く人が書くのは、いまどうあるべきか（view）と、押されたときの動きだけ。
//
// 値を持つ部品（checkbox・radio・slider・number・field・textarea・password・
// combo・listbox・tabs）は、**変数を ref で渡すのがいちばん短い**。動いたら
// その変数が直に書き換わるので、名札も update も ui.value() も要らない。
//   ui.checkbox("音を出す", ref sound)
//   ui.slider(ref volume, 0, 100)
//   ui.combo(ref iro, iro_na)
//
// ボタンのように値を持たないものは、動きをその場に書く。
//   ui.button("ふやす", func() -> void { count += 1; })
//
// 名札を付けて update で振り分ける形も残してある。その場に書いた関数からは
// 外側の局所変数が見えないので、升ごとに作るもの（ui.grid の cell）などはこちら。
//   ui.button("ふやす", "inc")
// 混ぜてよい。
//
// 格子を升ごとの関数から作る形（ui.grid(rows, cols, cell)）もここにある。
// 処理系（ネイティブ）からは Shark の関数を呼び戻せないので、関数を受ける形は Shark で書く。
//
// 状態は書く人がふつうの変数で持つ。ここは覚えない。
// 処理系はこのファイルを埋め込んで持ち、std.ui を入れたときだけ読み込む
// （core/shark.cpp）。core/prelude.h は tools/prelude.py がここから作る。
import std.ui;

public func run(title: string, width: int, height: int,
                view: func() -> Widget,
                update: func(string) -> void,
                resizable: bool) -> void {
  // 面は**画面の画素と1対1**に取る。細かさは丸めない数を使う ―
  // Windows の 125% やブラウザの拡大では 1.25・1.5 のような半端な数になり、
  // 整数に丸めた大きさで取ると機種が縮め直すので、字も線もにじむ
  var r = ui.pixel_ratio();
  ui.open(title, int(float(width) * r + 0.5), int(float(height) * r + 0.5), resizable);
  if ui.font_name() == "" { _ = ui.font(int(12.0 * r + 0.5)); }

  // 画面が無いところ（SHARK_UI=off など）では、1回だけ描いて返る。
  // 面はそのままにしておくので、ui.get() や ui.to_png() で結果を見られる
  if !ui.visible() {
    ui.clear();
    _ = ui.show(view());
    return;
  }

  while ui.poll() {
    ui.clear();
    var hit = ui.show(view());
    var changed = ui.edited();    // ref で受けた入力欄が、変数を書き換えた
    if ui.has_action() {          // 部品が関数を持っていれば、それを呼ぶ
      var act = ui.action();
      act();
      changed = true;
    }
    if hit != "" {                // 名札が付いていれば、update に渡す
      update(hit);
      changed = true;
    }
    if changed {                  // 状態が変わったので、すぐ描き直す
      ui.clear();
      _ = ui.show(view());
    }
    ui.present();
    ui.frame();
  }
  ui.close();
}

// resizable を省いた形。窓は縁を引いて大きさを変えられる
public func run(title: string, width: int, height: int,
                view: func() -> Widget,
                update: func(string) -> void) -> void {
  run(title, width, height, view, update, true);
}

// 部品に関数を持たせる書き方。update は要らない
public func run(title: string, width: int, height: int,
                view: func() -> Widget) -> void {
  run(title, width, height, view, __ui_ignore, true);
}

public func run(title: string, width: int, height: int,
                view: func() -> Widget, resizable: bool) -> void {
  run(title, width, height, view, __ui_ignore, resizable);
}

func __ui_ignore(hit: string) -> void {
}

// 格子を、升ごとの関数から作る。cell(行, 列) が返す部品を左上から右へ詰める。
// 並べ方は ui.grid(cols, cells) と同じ（core/lib/ui.cpp）
public func grid(rows: int, cols: int, cell: func(int, int) -> Widget) -> Widget {
  var cells: list<Widget> = [];
  for var r in range(rows) {
    for var c in range(cols) {
      cells.push(cell(r, c));
    }
  }
  return ui.grid(cols, cells);
}
