// ui.shk — std.ui の宣言。実装は core/lib/ui.cpp。

/// std.ui
///
/// 画面に描く。点・線・四角・円・文字と、キーとマウス。
///
/// 層が2つある。**下の層**は画素の並び（面）1枚と、押された・動いたという出来事だけ。
/// **上の層**は、部品を組んで `Widget` 1つにして返すと、そのとおりに描いてくれる。
/// 混ぜて使ってよい。上の層は下の層で書かれている。
///
/// 動かし方は、どちらの層でも毎回おなじ4つのくり返しになる。
///
///   1. ui.poll()      押された・動いた を取り込む
///   2. 描く            ui.clear / ui.fill_rect / ui.text … か、ui.show(部品)
///   3. ui.present()   描いたものを画面に出す
///   4. ui.frame()     次のこまの刻みまで待つ（sleep で待たない → ui.frame）
///
/// 画面を持たない機種でも、そのまま動く。描く先が**見えない面**になるだけで、
/// 描いた結果は ui.get() や ui.to_png() で取り出せる（ui.visible() で見分ける）。
///
/// `shark` コマンドは、macOS と Linux では窓を開く。窓を持てないところ
/// （ssh の先など）では、見えない面に描く。
/// 環境変数 `SHARK_UI` に `off` を入れると、窓を試さずにそうできる。
///
/// 字は内蔵の 5×7（ASCII だけ）で出る。日本語などを出したいときは
/// ui.font() で機種のフォントに切り替える（ブラウザではブラウザが描いてくれる）。
///
/// 例（動かさない）:
///   import std.ui;
///
///   ui.open("さめ", 160, 120);
///   var x = 10;
///   while ui.poll() {
///     if ui.key("right") { x += 2; }
///     if ui.pressed("esc") { ui.quit(); }
///     ui.clear(ui.rgb(0, 20, 40));
///     ui.fill_circle(x, 60, 12, ui.rgb(255, 140, 60));
///     ui.text(4, 4, "press esc to quit", ui.rgb(255, 255, 255));
///     ui.present();
///     ui.frame();
///   }
///   ui.close();
module std.ui;

// ------------------------------------------------------------------ 面

/// 描く先の面を用意する。大きさは画素の数。
///
/// 画面を持つ機種なら、同時に画面も開く。持たない機種や、出力を
/// ファイルに流しているときは、**見えない面**になる（ui.visible() が false）。
/// どちらでも描き方は変わらない。
///
/// もう開いているときは、いったん閉じてから開き直す。
///
/// 窓の出る機種では、窓の縁を引いて大きさを変えられる。変えると次の ui.poll() で
/// 面も同じ大きさに作り直され、ui.width() / ui.height() が新しい数を返す。
/// resizable に false を渡すと、大きさの**変わらない**窓になる
/// （窓の出ない機種では、面は開いたときのままで変わらない）。
///
/// 引数:
///   title      窓の名札。付けられない機種では使われない
///   width      横の画素の数（1〜16384）
///   height     縦の画素の数（1〜16384）
///   resizable  窓の縁を引いて大きさを変えられるか。省くと true
///
/// 例:
///   ui.open(64, 32);
///   print(f"{ui.width()}x{ui.height()}");   // 64x32
///   ui.close();
func open(width: int, height: int) -> void;
func open(title: string, width: int, height: int) -> void;
func open(title: string, width: int, height: int, resizable: bool) -> void;

/// 面を捨て、画面を開いていれば閉じる。
///
/// 例:
///   ui.open(8, 8);
///   ui.close();
///   print(ui.width());   // 0
func close() -> void;

/// 面の横の画素の数。開いていなければ 0。
///
/// 例:
///   ui.open(120, 80);
///   print(ui.width());   // 120
func width() -> int;

/// 面の縦の画素の数。開いていなければ 0。
///
/// 例:
///   ui.open(120, 80);
///   print(ui.height());   // 80
func height() -> int;

/// 画面の細かさ。ふつうは 1、細かい画面（HiDPI・Retina）なら 2。
///
/// **面を開く前に呼べる。**画面が細かいときは、面もそのぶん細かく取ると、
/// 面の1画素が画面の1画素にそのまま乗って、字がなめらかに出る。
///
/// 例:
///   var k = ui.scale();
///   ui.open("さめ", 420 * k, 300 * k);   // 見た目は 420×300 のまま、中身は細かく
///   _ = ui.font(12 * k);                 // 12pt くらい
///   print(ui.width() == 420 * k);        // true
func scale() -> int;

/// 描いたものが画面に出るか。
///
/// 画面を持たない機種と、出力をファイルに流しているときは false になる。
/// 描くことはできるので、ふつうは気にしなくてよい。
/// 出せないときだけ別のことをしたい（結果を PNG で保存するなど）ときに使う。
///
/// 例:
///   ui.open(8, 8);
///   if !ui.visible() { print("画面がありません"); }   // 画面がありません
func visible() -> bool;

/// 描いたものを画面に出す。
///
/// 描くだけでは画面は変わらない。1回ぶん描き終えたところで呼ぶ。
/// 画面が無いときは何もしない。
///
/// 例:
///   ui.open(16, 16);
///   ui.clear(ui.rgb(0, 0, 0));
///   ui.present();
func present() -> void;

/// 次のこまの刻みまで待つ。くり返しの終わりで呼ぶ。
///
/// **`sleep()` で待たないこと。**「1こま描いてから 16ms 眠る」と書くと、
/// 描くのにかかった分だけ足が出て、1こま 16.7ms に間に合わない。
/// ここは眠る長さではなく**刻限**を決めて待つので、描くのが速い機種でも
/// 遅い機種でも同じ速さで進む。
///
/// **ブラウザではとくに効く。**プログラムを進めるきっかけをブラウザが握っていて
/// （1秒に 60 回）、刻限のすぐ後ろに起きるとその回に間に合わず、次のきっかけまで
/// 丸ごと待つ。`sleep(0.016)` と書くと、それだけで**速さが半分（30）**になる。
///
/// 追いつけていないときは刻限を取り直すので、遅れがたまっていくことはない。
///
/// 引数:
///   fps   1秒に何こま進めたいか（1〜1000。省くと 60。外れると止まる）
///
/// 例:
///   ui.open(8, 8);
///   var n = 0;
///   while ui.poll() && n < 3 {
///     ui.clear(ui.rgb(0, 0, 0));
///     ui.present();
///     ui.frame(120);        // 120 のつもりで進める
///     n += 1;
///   }
///   print(n);   // 3
func frame() -> void;
func frame(fps: int) -> void;

// ------------------------------------------------------------------ 色

/// 赤・緑・青（それぞれ 0〜255）から色を作る。
///
/// 色は int 1つで表す。上から順に赤・緑・青の 8 ビットずつで、
/// 16 進で書けば 0xRRGGBB と同じ。0〜255 の外は端で止める。
///
/// 引数:
///   r   赤（0〜255）
///   g   緑（0〜255）
///   b   青（0〜255）
///
/// 例:
///   print(ui.rgb(255, 0, 0));   // 16711680
func rgb(r: int, g: int, b: int) -> int;

/// 赤・緑・青に「濃さ（不透明のぶん）」を足して色を作る。
///
/// a は 255 で不透明、0 でまるごと透明、途中なら半透明。
/// 半透明の色で描くと、下にあるものが透けて見える。
///
/// ui.rgb(r, g, b) は ui.rgba(r, g, b, 255) と同じ色になる。
/// **今までどおり描くぶんには、何も変わらない。**
///
/// 引数:
///   r, g, b   赤・緑・青（0〜255）
///   a         濃さ（0〜255）。255 が不透明
///
/// 例:
///   ui.open(4, 4);
///   ui.clear(ui.rgb(0, 0, 0));
///   ui.fill_rect(0, 0, 4, 4, ui.rgba(255, 255, 255, 128));   // 半分だけ白
///   print(ui.red(ui.get(1, 1)));   // 128
func rgba(r: int, g: int, b: int, a: int) -> int;

/// 色の濃さ（0〜255）。255 なら不透明、0 ならまるごと透明。
///
/// 例:
///   print(ui.alpha(ui.rgb(10, 20, 30)));         // 255
///   print(ui.alpha(ui.rgba(10, 20, 30, 128)));   // 128
func alpha(color: int) -> int;

/// 色の赤のぶん（0〜255）。
///
/// 例:
///   print(ui.red(ui.rgb(10, 20, 30)));   // 10
func red(color: int) -> int;

/// 色の緑のぶん（0〜255）。
///
/// 例:
///   print(ui.green(ui.rgb(10, 20, 30)));   // 20
func green(color: int) -> int;

/// 色の青のぶん（0〜255）。
///
/// 例:
///   print(ui.blue(ui.rgb(10, 20, 30)));   // 30
func blue(color: int) -> int;

/// 2つの色を混ぜる。t が 0.0 なら a、1.0 なら b。
///
/// 引数:
///   a   0.0 のときの色
///   b   1.0 のときの色
///   t   混ぜ具合（0.0〜1.0）
///
/// 例:
///   print(ui.mix(ui.rgb(0, 0, 0), ui.rgb(100, 100, 100), 0.5));   // 3289650
func mix(a: int, b: int, t: float) -> int;

// ------------------------------------------------------------------ 描く

/// 面ぜんぶを1色で塗る。切り抜き（ui.clip）の中だけを塗る。
///
/// 例:
///   ui.open(8, 8);
///   ui.clear(ui.rgb(0, 0, 255));
///   print(ui.get(4, 4));   // 255
func clear(color: int) -> void;

/// 点を1つ打つ。面の外は何も起きない。
///
/// 例:
///   ui.open(8, 8);
///   ui.set(2, 3, ui.rgb(255, 0, 0));
///   print(ui.get(2, 3));   // 16711680
func set(x: int, y: int, color: int) -> void;

/// その場所の色を読む。面の外は 0（黒）。
///
/// 描いた結果を確かめるのに使える。テストにも使う。
///
/// 例:
///   ui.open(8, 8);
///   ui.clear(ui.rgb(1, 2, 3));
///   print(ui.get(0, 0));    // 66051
///   print(ui.get(99, 0));   // 0
func get(x: int, y: int) -> int;

/// 横の線。x から右へ w 画素。
///
/// 例:
///   ui.open(8, 8);
///   ui.hline(0, 4, 8, ui.rgb(0, 255, 0));
///   print(ui.get(7, 4));   // 65280
func hline(x: int, y: int, w: int, color: int) -> void;

/// 縦の線。y から下へ h 画素。
///
/// 例:
///   ui.open(8, 8);
///   ui.vline(4, 0, 8, ui.rgb(0, 255, 0));
///   print(ui.get(4, 7));   // 65280
func vline(x: int, y: int, h: int, color: int) -> void;

/// 2点を結ぶ線。斜めにも引ける。
///
/// 例:
///   ui.open(8, 8);
///   ui.line(0, 0, 7, 7, ui.rgb(255, 255, 255));
///   print(ui.get(3, 3));   // 16777215
func line(x0: int, y0: int, x1: int, y1: int, color: int) -> void;

/// 四角の枠。左上が (x, y) で、横 w・縦 h。
///
/// 例:
///   ui.open(8, 8);
///   ui.rect(1, 1, 6, 6, ui.rgb(255, 0, 0));
///   print(ui.get(1, 1) != 0);   // true
///   print(ui.get(3, 3) != 0);   // false
func rect(x: int, y: int, w: int, h: int, color: int) -> void;

/// 中まで塗った四角。
///
/// 例:
///   ui.open(8, 8);
///   ui.fill_rect(1, 1, 6, 6, ui.rgb(255, 0, 0));
///   print(ui.get(3, 3) != 0);   // true
func fill_rect(x: int, y: int, w: int, h: int, color: int) -> void;

/// 円の輪郭。中心が (x, y) で半径 r。
///
/// 例:
///   ui.open(16, 16);
///   ui.circle(8, 8, 5, ui.rgb(255, 255, 0));
///   print(ui.get(8, 3) != 0);   // true
func circle(x: int, y: int, r: int, color: int) -> void;

/// 中まで塗った円。
///
/// 例:
///   ui.open(16, 16);
///   ui.fill_circle(8, 8, 5, ui.rgb(255, 255, 0));
///   print(ui.get(8, 8) != 0);   // true
func fill_circle(x: int, y: int, r: int, color: int) -> void;

/// この四角の中にだけ描くようにする。
///
/// 外にはみ出したぶんは捨てられる。一覧を枠の中で動かすときなどに使う。
/// 元に戻すには ui.clip_off()。
///
/// 例:
///   ui.open(16, 16);
///   ui.clip(0, 0, 8, 8);
///   ui.clear(ui.rgb(255, 0, 0));
///   print(ui.get(4, 4) != 0);    // true
///   print(ui.get(12, 12) != 0);  // false
func clip(x: int, y: int, w: int, h: int) -> void;

/// 切り抜きをやめて、面ぜんぶに描けるようにする。
///
/// 例:
///   ui.open(16, 16);
///   ui.clip(0, 0, 4, 4);
///   ui.clip_off();
///   ui.clear(ui.rgb(255, 0, 0));
///   print(ui.get(12, 12) != 0);   // true
func clip_off() -> void;

/// 画素の並びをそのまま置く。絵を貼るのに使う。
///
/// pixels は左上から右へ順に並べ、w 個ごとに次の行へ折り返す。
/// 縦の数は個数から決まるので渡さない。
///
/// 引数:
///   x, y     置く場所（左上）
///   w        並びの横幅（1 以上）
///   pixels   色の並び
///
/// 例:
///   ui.open(8, 8);
///   var dot = [ui.rgb(255, 0, 0), ui.rgb(0, 255, 0),
///              ui.rgb(0, 0, 255), ui.rgb(255, 255, 255)];
///   ui.blit(2, 2, 2, dot);
///   print(ui.get(3, 3));   // 16777215
func blit(x: int, y: int, w: int, pixels: list<int>) -> void;

// ------------------------------------------------------------------ 絵

/// 絵（画素の面）を作る。色を渡さなければ、まるごと透明で始まる。
///
/// 画面のほかにも描ける面が持てる。使い道は3つ。
///
///   ・絵を読んで出す（ui.load_png）
///   ・先に描いておいて何度も貼る（スプライト・地形）。毎回描き直すより速い
///   ・3D の描き先（絵.tri と ui.depth）
///
/// 絵は**ふつうの値**で、代入すればコピーになる。書き換えるまで中身は写さないので、
/// 「直す前に控えを取る」が安く書ける（絵を直す道具を作るときに効く）。
///
///   var 控え = 絵;      // ここでは写さない
///   絵.clear(0);        // ここで初めて写る。控えは元のまま
///
/// 描くメソッドは画面と同じ名前で、描き先だけが違う（絵.line など）。
///
/// 引数:
///   width, height   大きさ（画素。1〜16384）
///   color           埋める色（省くと、まるごと透明）
///
/// 例:
///   var e = ui.canvas(4, 4, ui.rgb(0, 0, 255));
///   print(f"{e.width()}x{e.height()} {e.get(2, 2)}");   // 4x4 255
func canvas(width: int, height: int) -> Canvas;
func canvas(width: int, height: int, color: int) -> Canvas;

/// PNG を読んで絵にする。読めなければ none。
///
/// 透明はそのまま入る。白黒・パレット・色つきのどれでも、
/// 深さは 1/2/4/8/16 ビットまで読める。**編み込み（interlace）だけは読めない**。
///
/// 書き戻すのは 絵.to_png()。読む → 直す → 書き戻す で透明は失われない。
///
/// 例:
///   var e = ui.canvas(2, 2, ui.rgba(255, 0, 0, 128));
///   if var back = ui.load_png(e.to_png()) {
///     print(f"{back.width()} {ui.alpha(back.get(0, 0))}");   // 2 128
///   }
func load_png(data: bytes) -> Canvas?;

/// 絵を今の面に貼る。透けているところは、下にあるものが残る。
///
/// 大きさを渡すと、その大きさに伸び縮みする。いちばん近い画素を取るので、
/// 粗い絵を大きくしても輪郭がぼけない（絵を直す道具の「拡大して見る」に使える）。
///
/// 引数:
///   image    貼る絵
///   x, y     置く場所（左上）
///   w, h     伸ばす大きさ（省くと、絵のままの大きさ）
///
/// 例:
///   var e = ui.canvas(2, 2, ui.rgb(0, 255, 0));
///   ui.open(8, 8);
///   ui.draw(e, 1, 1);
///   print(ui.get(2, 2));   // 65280
func draw(image: Canvas, x: int, y: int) -> void;
func draw(image: Canvas, x: int, y: int, w: int, h: int) -> void;

// ------------------------------------------------------------ 三角形と奥行き

/// 三角形を塗る。頂点は面の座標（x, y）と奥行き（z）。
///
/// **z は小さいほど手前。**ui.depth(true) にしてあれば、画素ごとに
/// 「もう手前に何かあるか」を見て、あれば描かない（奥行きの面＝z バッファ）。
/// これが 3D で唯一、組み合わせでは書けないところなので、ここに置いてある。
///
/// 回す・遠近をつけるといった見え方の計算は Shark の側で書く。
/// ここに渡すのは、計算し終わった**面の上の座標**。
///
/// 表と裏の選り分けはしない（どちら回りでも塗る）。要るなら、
/// 3つの頂点の向きから自分で決める。
///
/// 例:
///   ui.open(8, 8);
///   ui.tri(0, 0, 0, 7, 0, 0, 0, 7, 0, ui.rgb(255, 0, 0));
///   print(f"{ui.get(1, 1)} {ui.get(6, 6)}");   // 16711680 0
func tri(x0: int, y0: int, z0: int, x1: int, y1: int, z1: int, x2: int, y2: int, z2: int, color: int) -> void;

/// 奥行きの面（z バッファ）を使うかどうか。
///
/// true にすると ui.tri() が z を見るようになる。false で使うのをやめ、面も返す。
/// 面は1枚だけを使い回し、描き先の大きさに合わせて取り直す。
///
/// 例:
///   ui.open(8, 8);
///   ui.depth(true);
///   ui.clear_depth();
///   ui.tri(0, 0, 50, 7, 0, 50, 0, 7, 50, ui.rgb(0, 255, 0));   // 奥
///   ui.tri(0, 0, 10, 7, 0, 10, 0, 7, 10, ui.rgb(255, 0, 0));   // 手前
///   print(ui.get(1, 1));   // 16711680
///   ui.depth(false);
func depth(on: bool) -> void;

/// 奥行きの面を「いちばん遠い」に戻す。ひとこまごとに1回呼ぶ。
///
/// ui.depth(false) のときは何も起きない。
///
/// 例:
///   ui.open(8, 8);
///   ui.depth(true);
///   ui.clear_depth();
///   print(ui.width());   // 8
///   ui.depth(false);
func clear_depth() -> void;

// ------------------------------------------------------------------ 文字

/// 文字を描く。左上が (x, y)。
///
/// 字形は処理系が持っている（5×7 の点。1文字ぶんの枠は 6×8）。
/// scale を渡すと、その倍に引き伸ばす。改行（\n）で次の行に移る。
///
/// 内蔵の字形は ASCII だけで、日本語などは □ になる。
/// ui.font() で機種のフォントを読むと、日本語も出せる。
///
/// 引数:
///   x, y    左上の位置
///   s       描く文字
///   color   色
///   scale   何倍にするか（省くと 1）
///
/// 例:
///   ui.open(64, 16);
///   ui.text(1, 1, "Hi", ui.rgb(255, 255, 255));
///   print(ui.get(1, 1));   // 16777215
func text(x: int, y: int, s: string, color: int) -> void;
func text(x: int, y: int, s: string, color: int, scale: int) -> void;

/// その文字を描いたときの横幅（画素）。
///
/// 真ん中に置きたいときに使う。改行があれば、いちばん長い行の幅。
/// ui.font() でフォントを読んでいれば、その字幅で数える。
///
/// 例:
///   ui.font_builtin();
///   print(ui.text_width("Hi"));      // 12
///   print(ui.text_width("Hi", 2));   // 24
func text_width(s: string) -> int;
func text_width(s: string, scale: int) -> int;

/// 1行ぶんの高さ（画素）。**字の上端から下端まで**で、上下にあきを含まない。
///
/// 部品の高さもこれで決まる。改行（\n）のときは、これより少し広く下げる。
///
/// 例:
///   ui.font_builtin();
///   print(ui.text_height());    // 8
///   print(ui.text_height(3));   // 24
func text_height() -> int;
func text_height(scale: int) -> int;

// ------------------------------------------------------------------ 入力

/// 押された・動いたを取り込む。閉じてくれと言われていたら false。
///
/// くり返しの先頭で1回だけ呼ぶ。ui.key() や ui.mouse_x() が返すのは、
/// **最後に poll したときの様子**で、その間は変わらない。
///
/// 画面を持たない機種では、何も起きないまま true を返し続ける。
///
/// 例:
///   ui.open(8, 8);
///   var n = 0;
///   while ui.poll() && n < 3 { n += 1; }
///   print(n);   // 3
func poll() -> bool;

/// 閉じてくれと言われたことにする。次の ui.poll() が false を返す。
///
/// 例:
///   ui.open(8, 8);
///   ui.quit();
///   print(ui.poll());   // false
func quit() -> void;

/// そのキーが今そのとき押されているか。
///
/// 名前は、印字できる文字ならその文字そのもの（"a" "1" "-"）。
/// 大文字と小文字は区別しない。そのほかは次の名前で呼ぶ。
///
///   "left" "right" "up" "down" "space" "enter" "esc" "tab" "back"
///   "delete" "home" "end" "pageup" "pagedown" "shift" "ctrl" "alt"
///   "f1"〜"f12"
///
/// 注意:
///   「離した」が届かない機種では、押された刻みの間だけ true になる。
///   押しっぱなしで動かし続けたいときは、機種の作りに任せず、
///   ui.pressed() で向きを覚えておく方が確かになる（spec/library/ui.md）。
///
/// 例:
///   ui.open(8, 8);
///   _ = ui.poll();
///   print(ui.key("right"));   // false
func key(name: string) -> bool;

/// そのキーが、この刻みで押されたか。押し続けても最初の1回だけ true。
///
/// 例:
///   ui.open(8, 8);
///   _ = ui.poll();
///   print(ui.pressed("space"));   // false
func pressed(name: string) -> bool;

/// そのキーが、この刻みで離されたか。
///
/// 例:
///   ui.open(8, 8);
///   _ = ui.poll();
///   print(ui.released("space"));   // false
func released(name: string) -> bool;

/// この刻みで打たれた文字。何も打たれていなければ空。
///
/// キーの名前ではなく、実際に入った文字が返る。入力欄を作るときに使う。
///
/// 例:
///   ui.open(8, 8);
///   _ = ui.poll();
///   print(f"[{ui.typed()}]");   // []
func typed() -> string;

/// マウスの横の位置（面の中の画素）。
///
/// 例:
///   ui.open(8, 8);
///   _ = ui.poll();
///   print(ui.mouse_x());   // 0
func mouse_x() -> int;

/// マウスの縦の位置（面の中の画素）。
///
/// 例:
///   ui.open(8, 8);
///   _ = ui.poll();
///   print(ui.mouse_y());   // 0
func mouse_y() -> int;

/// そのボタンが今そのとき押されているか。0 が左、1 が中、2 が右。
///
/// 例:
///   ui.open(8, 8);
///   _ = ui.poll();
///   print(ui.mouse(0));   // false
func mouse(button: int) -> bool;

/// そのボタンが、この刻みで押されたか。押した瞬間だけ true。
///
/// ボタンを作るときは、これと場所の重なりを見る。
///
/// 例:
///   ui.open(16, 16);
///   _ = ui.poll();
///   if ui.clicked(0) && ui.mouse_x() < 8 { print("左半分が押された"); }
func clicked(button: int) -> bool;

/// 車輪（ホイール）が、この回に送られたぶん。行の数で、**下へ送るときが正**。
///
/// 巻物を持つ部品（ui.listbox・ui.textarea・ui.combo の一覧）は、カーソルが
/// 乗っていれば**自分で使い切る**。そのときここは 0 になるので、
/// 部品と、自分で書いた巻物とが二重に動くことはない。
///
/// 出し先からは**行より細かく**届く（トラックパッドをゆっくり動かしたぶんも落ちない）。
/// ここが返すのは行の数なので、1行に満たないぶんは次の回へ持ち越して、
/// たまったところで返る。車輪を持っていない出し先では、いつも 0。
///
/// 例:
///   ui.open(80, 40);
///   _ = ui.poll();
///   print(ui.wheel());   // 0
func wheel() -> int;

/// 横に送られたぶん。行の数で、**右へ送るときが正**。
///
/// トラックパッドや、横にも回る車輪で届く。
///
/// 例:
///   ui.open(80, 40);
///   _ = ui.poll();
///   print(ui.wheel_x());   // 0
func wheel_x() -> int;

/// マウスの形を決める。押せるところに合わせたら手にする、など。
///
/// **その回かぎり**で、次の ui.poll() で `arrow`（ふつう）に戻る。
/// 描き直すたびに「いまその場所にふさわしい形」を頼む、という使い方をする。
/// 宣言的な層（ui.show / ui.run）は、ボタン・つまみ・入力欄の上で自分で形を変えるので、
/// 呼ぶ必要は無い。
///
/// 使える名前:
///   arrow     ふつう
///   hand      押せるところ
///   text      文字を打つところ
///   cross     照準
///   wait      待たせているところ
///   resize_x  横に伸ばす
///   resize_y  縦に伸ばす
///   move      つかんで動かす
///   none      消す（自分でマウスを描くとき）
///
/// 持っていない形は、その機種で近いものになる。形を持たない出し先や、
/// 画面が無いときは何も起きない。
///
/// 例:
///   ui.open(60, 30);
///   _ = ui.poll();
///   if ui.mouse_x() < 30 { ui.cursor("hand"); }   // 左半分は押せる、という見せ方
///   ui.present();
///   print(ui.width());   // 60
func cursor(name: string) -> void;

// ------------------------------------------------------------------ 文字入力

/// その場所で文字を受け取る。日本語などの変換（IME）も通る。
///
/// 自分で入力欄を描くとき用（ui.field は中でこれを使っている）。
/// **受け付けているあいだ、毎回呼ぶ。**呼ぶのをやめるか ui.input_off() を呼ぶと止まる。
///
/// 返るのは**確定した中身**。変換中の文字は ui.marked() で別に取れるので、
/// 確定ぶんの後ろに下線つきで出す。
///
/// 引数:
///   x, y, h   入力欄の位置と高さ。変換の候補をこのあたりに出してもらう
///   value     いまの中身（呼んだ側が持っているもの）
///
/// 注意:
///   変換を機種に任せられるかは出し先による（ui.has_ime()）。
///   任せられないときは、打たれた文字がそのまま入り、back で1文字消える。
///
///   変換中のキー（確定の enter、取り消しの esc、候補を選ぶ空白と矢印）は、
///   プログラムには届かない。ui.pressed("enter") などで受けているものと
///   ぶつからないようにするため。
///
/// 例:
///   ui.open(120, 40);
///   var name = "さめ";
///   _ = ui.poll();
///   name = ui.input(4, 4, 16, name);
///   print(name);   // さめ
func input(x: int, y: int, h: int, value: string) -> string;

/// 文字の受け付けをやめる。
///
/// 例:
///   ui.open(80, 40);
///   ui.input_off();
///   print(ui.marked());   //
func input_off() -> void;

/// 変換中（未確定）の文字列。無ければ空。
///
/// 確定した文字の後ろに、下線を引いて出す。
///
/// 例:
///   ui.open(80, 40);
///   print(f"[{ui.marked()}]");   // []
func marked() -> string;

/// 変換つきの文字入力を、出し先が持っているか。
///
/// 窓（macOS）とブラウザなら true。それ以外や、画面が無いときは false で、
/// そのときは打たれた文字がそのまま入る。
///
/// 例:
///   ui.open(80, 40);
///   if !ui.has_ime() { print("変換は出し先に任せられません"); }
///   // 変換は出し先に任せられません
func has_ime() -> bool;

// ------------------------------------------------------------ 切り貼りとメニュー

/// いま選んでいる文字。選んでいなければ空。
///
/// 入力欄（ui.field）や ui.input() で選んでいるところ。
///
/// 例:
///   ui.open(120, 40);
///   _ = ui.poll();
///   print(f"[{ui.selected()}]");   // []
func selected() -> string;

/// 切り貼りの置き場（クリップボード）の中身。
///
/// 持っていない出し先では空が返る。
///
/// 例:
///   ui.open(80, 40);
///   var s = ui.clipboard();
///   print(s.len() >= 0);   // true
func clipboard() -> string;

/// 切り貼りの置き場に入れる。入れられなければ false。
///
/// 例（動かさない）:
///   ui.open(80, 40);
///   if ui.set_clipboard("さめ") {
///     print(ui.clipboard());   // さめ
///   }
func set_clipboard(s: string) -> bool;

/// この場所にメニューを出す。
///
/// 選ばれるか、外を押されるまで出たまま。押されたところはメニューが先に受け取るので、
/// 下にある部品は反応しない。番号は ui.menu_pick() で受け取る。
///
/// **押したまま動かして、選びたいところで離す**でも選べる。
/// 面に入りきらないときは、上と下に送るしるし（▲▼）が出て、
/// そこに合わせているあいだ少しずつ送れる。
///
/// 入力欄（ui.field）は、右で押すと**切り貼りのメニューを自分で出す**ので、
/// これを書く必要はない。
///
/// 引数:
///   x, y     出す場所（面からはみ出すときは中に寄せる）
///   items    並べる文字
///
/// 例:
///   ui.open(120, 80);
///   if ui.clicked(2) { ui.menu(ui.mouse_x(), ui.mouse_y(), ["消す", "やり直す"]); }
///   print(ui.menu_open());   // false
func menu(x: int, y: int, items: list<string>) -> void;

/// この回に選ばれたメニューの番号。選ばれていなければ -1。
///
/// 例:
///   ui.open(120, 80);
///   ui.menu(4, 4, ["消す", "やり直す"]);
///   var pick = ui.menu_pick();
///   if pick == 0 { print("消す"); }
///   print(pick);   // -1
func menu_pick() -> int;

/// メニューを閉じる。
///
/// 例:
///   ui.open(120, 80);
///   ui.menu(4, 4, ["消す"]);
///   ui.menu_close();
///   print(ui.menu_open());   // false
func menu_close() -> void;

/// メニューが出ているか。
///
/// 例:
///   ui.open(120, 80);
///   ui.menu(4, 4, ["消す"]);
///   print(ui.menu_open());   // true
func menu_open() -> bool;

// ------------------------------------------------------------------ 取り出す

/// 今の面を PNG にして返す。
///
/// 画面が無いところでも、描いた結果をそのまま渡せる。
/// 縮めずに入れるので、同じ絵の PNG より少し大きい。
///
/// 例:
///   ui.open(4, 4);
///   ui.clear(ui.rgb(255, 0, 0));
///   var png = ui.to_png();
///   print(png.len() > 0);                            // true
///   print(png.to_hex().starts_with("89504e47"));     // true
func to_png() -> bytes;

// ------------------------------------------------------------------ フォント

/// 機種のフォントに切り替えて、日本語などを出せるようにする。
///
/// 何も呼ばなければ**内蔵の 5×7 の字形**のまま。内蔵は ASCII しか持たないが、
/// どの機種でも同じ大きさ・同じ形で出る。機種のフォントにすると日本語は出せるが、
/// 字の幅も高さも**その機種のフォント次第**になる。どちらを取るかは書く人が決める。
///
/// 出どころは2つあり、この順に試す。どちらも無ければ false を返し、
/// 内蔵の字形のまま動き続ける。
///
///   1. FreeType でフォントのファイルを読む（処理系を FreeType つきで作ったとき。
///      入れ方は README の「日本語の字を出す」）
///   2. 機種に描いてもらう（ブラウザはこちら。フォントのファイルは読めないので、
///      ブラウザに1文字ずつ描いてもらう）
///
/// 大きさは**画素**で渡す。画面が細かいところでも同じ見た目にするなら、
/// ui.scale() を掛ける（`ui.font(12 * ui.scale())` で 12pt くらい）。
///
/// 探すのは本文の太さ（Regular くらい）のもの。別の太さにしたいときは、
/// そのフォントの場所を渡す。
///
/// 引数:
///   size    字の大きさ（画素）
///   path    フォントの場所（.ttf .otf .ttc）。機種に描いてもらうところ（ブラウザ）
///           では、場所ではなく**フォントの名前**として渡る（例: "Meiryo"）
///   data    フォントの中身（自分で読んだもの）。FreeType が要る
///
/// 探す順番は、環境変数 `SHARK_FONT` → 機種によくある場所 → 機種に描いてもらう。
///
/// 読んだフォントが**持っていない字**（絵文字やハングルなど）は、機種のフォントから
/// 探し直す。控えは要るときに1本ずつ読み、どれも持っていなければ □ になる。
/// 控えを自分で決めたいときは、環境変数 `SHARK_FONT_FALLBACK`（`;` 区切り）に入れる。
///
/// 例:
///   ui.open(200, 60);
///   if ui.font(16) {
///     ui.text(4, 4, "こんにちは", ui.rgb(255, 255, 255));
///   }
///   print(ui.width());   // 200
func font(size: int) -> bool;
func font(path: string, size: int) -> bool;
func font(data: bytes, size: int) -> bool;

/// 内蔵の 5×7 の字形に戻す。
///
/// 例:
///   ui.open(80, 40);
///   ui.font_builtin();
///   print(ui.text_height());   // 8
func font_builtin() -> void;

/// いま使っているフォントの場所。機種に描いてもらっているとき（ブラウザ）は、
/// その名前（例: `Hiragino Sans`）。内蔵の字形なら空。
///
/// 例:
///   ui.open(80, 40);
///   ui.font_builtin();
///   print(f"[{ui.font_name()}]");   // []
func font_name() -> string;

// ------------------------------------------------------------ 宣言的な層

/// 宣言的に書くときの入り口。**くり返しも描き直しも引き受ける。**
///
/// 書くのは view() だけでよい。状態はふつうの変数で持ち、部品には **ref で渡す**。
/// 動いたらその変数が直に書き換わるので、update も名札も ui.value() も要らない。
///
///   view()        いまどうあるべきか（部品1つ。並べるなら ui.col などに入れる）を返す
///   update(hit)   押されたものの名札を受け取って、状態を変える（**省ける**）
///
/// 中でしていること。
///
///   1. 面を開く（細かい画面なら細かく取り、字も読む）
///   2. 押された・動いた を取り込む
///   3. view() を呼んで、そのとおりに描く
///   4. 何か押されていれば update() を呼び、**その場で描き直す**
///   5. 窓が閉じられるか ui.quit() まで、2 に戻る
///
/// ref で渡すか、部品に関数を持たせているなら、update は要らない（省いた形）。
///
/// 引数:
///   title           窓の名札
///   width, height   見た目の大きさ（細かい画面では自動で細かく取る）
///   view            いまの姿を返す関数
///   update          押されたものの名札を受け取る関数（省ける）
///   resizable       窓の縁を引いて大きさを変えられるか。省くと true
///
/// 注意:
///   画面が無いところ（SHARK_UI=off など）では、1回だけ描いて返る。
///   面はそのままなので、ui.get() や ui.to_png() で結果を見られる。
///   字の大きさを自分で決めたいときは、呼ぶ前に ui.font() を呼んでおく。
///
/// 例:
///   var count = 0;
///   var sound = true;
///   func view() -> Widget {
///     return ui.col([
///       ui.label(f"{count} 回"),
///       ui.button("ふやす", func() -> void { count += 1; }),
///       ui.checkbox("音を出す", ref sound),   // 押されたら sound が直に変わる
///     ]);
///   }
///   ui.run("かうんた", 200, 120, view);       // update は要らない
///   print(f"{count} {sound}");   // 0 true
func run(title: string, width: int, height: int, view: func() -> Widget, update: func(string) -> void) -> void;
func run(title: string, width: int, height: int, view: func() -> Widget, update: func(string) -> void, resizable: bool) -> void;
func run(title: string, width: int, height: int, view: func() -> Widget) -> void;
func run(title: string, width: int, height: int, view: func() -> Widget, resizable: bool) -> void;

/// ラベル。文字を出す部品。
///
/// 部品は `Widget` という値で、作っただけでは何も起きない。
/// ui.show() に渡すと、そこで初めて描かれる。並べるときは
/// ui.col / ui.row / ui.grid に配列で入れて、1つにする。
///
/// 長い文が置ける幅（親がくれた幅か、.width(n) で決めた幅）に入らないときは、
/// **折り返して**何行かになる。折り目はその行の空白、無ければ字の手前。
///
/// 例:
///   ui.open(80, 40);
///   _ = ui.show(ui.label("こんにちは"));
///   print(ui.get(5, 4) != 0);   // true
func label(text: string) -> Widget;

/// ボタン。押せる。
///
/// 押されたときの受け取り方は2つ。**関数を渡すと、押されたときに呼ばれる。**
/// 名札（`id`）を渡すと、ui.show() がその名札を返す。
///
/// ```
/// ui.button("ふやす", func() -> void { n += 1; })   // その場に書く
/// ui.button("ふやす", inc)                          // 名前を付けた関数でもよい
/// ui.button("ふやす", "inc")                        // ui.show() が "inc" を返す
/// ```
///
/// 引数:
///   label    出す文字
///   action   押されたときに呼ぶ関数
///   id       名札（関数の代わりに渡す）
///
/// 例:
///   var n = 0;
///   ui.open(120, 40);
///   _ = ui.show(ui.button("ふやす", func() -> void { n += 1; }));
///   print(n);   // 0（まだ押していない）
func button(label: string, id: string) -> Widget;
func button(label: string, action: func() -> void) -> Widget;

/// チェックボックス。入切のチェック。
///
/// **変数を ref で渡すのがいちばん短い。**押されるたびに、その変数が
/// 直に入切します。名札も update() も ui.value() も要りません。
///
/// ```
/// ui.checkbox("音を出す", ref sound)        // sound が直にひっくり返る
/// ui.checkbox("音を出す", "sound", sound)   // ui.show() が "sound" を返す
/// ```
///
/// 名札の代わりに関数を渡すと、押されたときにその関数が呼ばれる
/// （新しい入切は、その中で ui.value() を読む）。
///
/// 引数:
///   label   出す文字
///   on      いま入っているか（ref なら、書き換える先の変数）
///   id      名札
///
/// 注意:
///   ref で渡せるのは**一番外側の var** だけ（誤り E0307）。ui.field と同じ理由で、
///   覚えているのは借用ではなく「どの var か」だから。
///
/// 例:
///   ui.open(80, 40);
///   var on = true;
///   _ = ui.show(ui.checkbox("音を出す", ref on));
///   print(on);   // true（まだ押していない）
func checkbox(label: string, id: string, on: bool) -> Widget;
func checkbox(label: string, action: func() -> void, on: bool) -> Widget;
func checkbox(label: string, ref on: bool) -> Widget;

/// ラジオボタン。丸いほうのチェックで、**いくつか並べて、そのうち1つを選ぶ**。
///
/// **同じ変数を ref で渡し、それぞれに「自分の数」を持たせるのがいちばん短い。**
/// 押されると、その数が変数に入る。選ばれて見えるのは、変数と自分の数が同じとき。
///
/// ```
/// ui.row([ui.radio("小", ref mode, 0),
///         ui.radio("中", ref mode, 1),
///         ui.radio("大", ref mode, 2)])
/// ```
///
/// 名札を渡す形もある。そのときは「自分が選ばれているか」を bool で渡し、
/// 押されたら ui.show() が名札を返す。
///
/// 引数:
///   label   出す文字
///   value   いまの数（ref なら、書き換える先の変数）
///   mine    自分の数。押されたらこれが入る
///   id      名札（ref の代わりに渡す）
///   on      いま選ばれているか（名札の形で渡す）
///
/// 例:
///   ui.open(160, 40);
///   var mode = 1;
///   _ = ui.show(ui.row([ui.radio("小", ref mode, 0), ui.radio("大", ref mode, 1)]));
///   print(mode);   // 1（まだ押していない）
func radio(label: string, id: string, on: bool) -> Widget;
func radio(label: string, action: func() -> void, on: bool) -> Widget;
func radio(label: string, ref value: int, mine: int) -> Widget;

/// スライダー（つまみ）。lo から hi までの数を選ぶ。
///
/// **変数を ref で渡すのがいちばん短い。**動かすたびに、その変数が書き換わる。
///
/// ```
/// ui.slider(ref vol, 0, 100)        // vol が直に書き換わる
/// ui.slider("vol", vol, 0, 100)     // ui.show() が "vol" を返す
/// ```
///
/// **つかんだら、離すまで付いてくる。**つまみの外へマウスが出ても止まらないので、
/// 行き過ぎても戻せる。
///
/// 名札の代わりに関数を渡すと、動かされている間その関数が呼ばれる
/// （新しい数は、その中で ui.value() を読む）。
///
/// 引数:
///   value   いまの数（ref なら、書き換える先の変数）
///   lo, hi  下と上
///   id      名札（ref の代わりに渡す）
///
/// 例:
///   ui.open(120, 40);
///   var vol = 40;
///   _ = ui.show(ui.slider(ref vol, 0, 100));
///   print(vol);   // 40（まだ動かしていない）
func slider(id: string, value: int, lo: int, hi: int) -> Widget;
func slider(action: func() -> void, value: int, lo: int, hi: int) -> Widget;
func slider(ref value: int, lo: int, hi: int) -> Widget;

/// 数の入力欄（スピンボックス）。**lo から hi の外には出られない。**
///
/// 打てるのは数字だけ（lo が負のときは、先頭の `-` も打てる）。
/// 限りから出てしまう数は**打っても入らない**ので、範囲の外の値になることがない。
/// 右の − と ＋ でも 1 ずつ動かせる（上下の矢印も同じ）。
///
/// **変数を ref で渡すのがいちばん短い。**打つたびに、その変数が書き換わる。
///
/// ```
/// ui.number(ref age, 0, 120)        // age が直に書き換わる
/// ui.number("age", age, 0, 120)     // ui.show() が "age" を返す
/// ```
///
/// 名札の代わりに関数を渡したときは、その中で ui.value() を読む。
///
/// 引数:
///   value   いまの数（ref なら、書き換える先の変数）
///   lo, hi  下と上（この間しか入らない）
///   id      名札（ref の代わりに渡す）
///
/// 注意:
///   打っている途中は「まだ数になっていない形」（空や `-` だけ）も通る。
///   その間 ui.show() は名札を返さないので、こちらの変数は前のままでよい。
///   enter か、外を押すと打ち終わり。esc で打つ前に戻る。
///
/// 例:
///   ui.open(160, 40);
///   var age = 12;
///   if ui.show(ui.number("age", age, 0, 120)) == "age" { age = ui.value(); }
///   print(age);   // 12
func number(id: string, value: int, lo: int, hi: int) -> Widget;
func number(action: func() -> void, value: int, lo: int, hi: int) -> Widget;
func number(ref value: int, lo: int, hi: int) -> Widget;

/// テキストフィールド。1行の入力欄。
///
/// 押すとそこに文字が入るようになる。受け取り方は2つ。
///
/// **変数を ref で渡すと、打たれるたびにその変数が書き換わる。**
/// 名札（`id`）を渡したときは、打たれるたびに ui.show() がその名札を返すので、
/// ui.text_value() で新しい文字を受け取り、自分の変数に入れ直す。
///
/// ```
/// ui.field(ref name)        // name が直に書き換わる
/// ui.field("name", name)    // ui.show() が "name" を返す
/// ```
///
/// 文字を持つのはどちらの形でも書く人で、処理系は覚えない。だから画面と食い違わない。
///
/// 引数:
///   value   いま入っている文字（ref なら、書き換える先の変数）
///   id      名札（ref の代わりに渡す）
///
/// 注意:
///   ref で渡せるのは**一番外側の var** だけ（誤り E0307）。ほかのモジュールの var でもよい。
///   覚えているのは借用ではなく「どの var か」で、書き戻しはその var への代入と同じ。
///   関数の中の変数は返ると消えるので渡せない。使いたいときは名札の形にする。
///
///   日本語などの変換は**出し先に任せる**。窓（macOS・Windows）とブラウザでは
///   変換中の文字が下線つきで出て、確定したものが入る。
///   任せられない出し先では、打った文字がそのまま入る。
///   後ろの1文字を消すのは back、入力欄から離れるのは enter。
///   変換中の enter は「確定」なので、入力欄からは離れない。
///
///   なぞれば選べる。矢印で動かし、shift を押しながらなら選びながら動く。
///   続けて押すと、2回で語（空白から空白まで）、3回で行、4回でぜんぶ選ぶ。
///   取り消しは Cmd-Z（Windows と Linux は Ctrl-Z）、やり直しは Shift を足すか Ctrl-Y。
///   右で押すと、コピー・切り取り・貼り付け・すべて選ぶ のメニューが出る。
///   窓（macOS）では Cmd-C / Cmd-V / Cmd-X / Cmd-A、
///   窓（Windows）では ctrl+C / ctrl+V / ctrl+X / ctrl+A も効く。
///
/// 例:
///   ui.open(140, 60);
///   var name = "さめ";
///   var nick = "しゃち";
///   var hit = ui.show(ui.col([ui.field(ref name), ui.field("nick", nick)]));
///   if hit == "nick" { nick = ui.text_value(); }
///   print(f"[{hit}] {name} {nick}");   // [] さめ しゃち
func field(ref value: string) -> Widget;
func field(id: string, value: string) -> Widget;

/// テキストエリア。複数行の入力欄で、長い文やメモを打つところ。
///
/// 受け取り方は ui.field と同じ2つ。**変数を ref で渡すと、打たれるたびに
/// その変数が書き換わる。**名札（`id`）を渡したときは、ui.show() がその名札を
/// 返すので、ui.text_value() で新しい文字を受け取る。
///
/// ```
/// ui.textarea(ref memo)         // memo が直に書き換わる
/// ui.textarea(ref memo, 8)      // 8 行ぶんの高さで出す
/// ui.textarea("memo", memo)     // ui.show() が "memo" を返す
/// ```
///
/// 中身は**改行（`\n`）を持つ1つの文字列**。行に分けたいときは
/// `memo.split("\n")` のように、書く人の側で分ける。
///
/// 引数:
///   value   いま入っている文字（ref なら、書き換える先の変数）
///   id      名札（ref の代わりに渡す）
///   rows    見せる行の数。省くと 4 行
///
/// 注意:
///   置ける幅に入らない行は**折り返して**出る。折り目はその行の空白、無ければ字の手前
///   （ui.label と同じ）。折り返しても中身の文字列は変わらない。
///
///   enter は**改行を入れる**（ui.field は入力欄から離れる）。離れるのは、
///   外を押すか esc。上下の矢印で行を行き来し、home と end でその行の端に行く。
///   行が入りきらないときは、右に今どのあたりかの帯が出る。
///
///   なぞって選ぶ、右で押して切り貼りのメニュー、日本語などの変換は ui.field と同じ。
///
/// 例:
///   ui.open(200, 140);
///   var memo = "さめは 海に すんでいます。\n2行目";
///   var hit = ui.show(ui.col([ui.label("メモ"), ui.textarea(ref memo, 3)]));
///   var lines = memo.split("\n");
///   print(f"[{hit}] {lines.len()}");   // [] 2
func textarea(ref value: string) -> Widget;
func textarea(ref value: string, rows: int) -> Widget;
func textarea(id: string, value: string) -> Widget;
func textarea(id: string, value: string, rows: int) -> Widget;

/// パスワード欄。伏せ字の入力欄で、あいことばを打つところ。
///
/// 中身の持ち方も受け取り方も ui.field と同じで、**出すときだけ**1字を1つの
/// `*` に置き換える。ui.text_value() や渡した変数には、打たれた字がそのまま入る。
///
/// 引数:
///   value   いま入っている文字（ref なら、書き換える先の変数）
///   id      名札（ref の代わりに渡す）
///
/// 注意:
///   右で押したときのメニューに、**コピーと切り取りは出ない**（中身が持ち出せてしまうため）。
///   貼り付けとすべて選ぶは出る。
///
/// 例:
///   ui.open(160, 40);
///   var word = "さめ";
///   _ = ui.show(ui.password(ref word));
///   print(word);   // さめ
func password(ref value: string) -> Widget;
func password(id: string, value: string) -> Widget;

/// プルダウン（コンボボックス）。押すと一覧が出て、その中の1つを選ぶ。
///
/// **番号の変数を ref で渡すのがいちばん短い。**選ばれるたびに、その変数が書き換わる
/// （番号は 0 から）。
///
/// ```
/// ui.combo(ref iro, iro_na)         // iro が直に書き換わる
/// ui.combo("iro", iro_na, iro)      // ui.show() が "iro" を返す
/// ```
///
/// 名札の代わりに関数を渡したときは、その中で ui.value() を読む。
///
/// 選び方は2つあり、どちらでもよい。
///
///   ・押して離すと一覧が出たままになる。そのあともう一度押して選ぶ
///   ・**押したまま下へ動かし、選びたいところで離す**（プルダウンのふつうの選び方）
///
/// 一覧が面に入りきらないときは、上と下に送るしるし（▲▼）が出る。
/// そこにカーソルを合わせているあいだ、少しずつ送れる（押したままでも送れる）。
///
/// 引数:
///   index     いま選ばれているものの番号（ref なら、書き換える先の変数）
///   options   並べる文字
///   id        名札（ref の代わりに渡す）
///
/// 例:
///   ui.open(160, 60);
///   var iro_na = ["あか", "あお", "みどり"];
///   var pick = 1;
///   _ = ui.show(ui.combo(ref pick, iro_na));
///   print(iro_na[pick]);   // あお
func combo(id: string, options: list<string>, index: int) -> Widget;
func combo(action: func() -> void, options: list<string>, index: int) -> Widget;
func combo(ref index: int, options: list<string>) -> Widget;

/// リストボックス。並べたものが見えていて、その中の1つを選ぶ。
///
/// 受け取り方は ui.combo と同じ（ref で渡すか、名札＋ui.value()）。
///
/// ```
/// ui.listbox(ref sel, sakana, 5)    // sel が直に書き換わる
/// ui.listbox("s", sakana, sel, 5)   // ui.show() が "s" を返す
/// ```
///
/// 入りきらないときは右に帯が出る。**帯はつまんで動かせる**ので、
/// 選んでいるものから離れたところも見に行ける。押して焦点が来ているあいだは、
/// 上下の矢印でも選べる（選んだものが見えるところまで、ひとりでに送る）。
///
/// 引数:
///   index     いま選ばれているものの番号（ref なら、書き換える先の変数）
///   options   並べる文字
///   rows      見せる行の数。省くと 4 行
///   id        名札（ref の代わりに渡す）
///
/// 例:
///   ui.open(160, 100);
///   var sakana_na = ["さめ", "しゃち", "いるか"];
///   var sel = 0;
///   _ = ui.show(ui.listbox(ref sel, sakana_na, 3));
///   print(sakana_na[sel]);   // さめ
func listbox(id: string, options: list<string>, index: int) -> Widget;
func listbox(id: string, options: list<string>, index: int, rows: int) -> Widget;
func listbox(action: func() -> void, options: list<string>, index: int) -> Widget;
func listbox(action: func() -> void, options: list<string>, index: int, rows: int) -> Widget;
func listbox(ref index: int, options: list<string>) -> Widget;
func listbox(ref index: int, options: list<string>, rows: int) -> Widget;

/// タブ（の見出し）。**出すのは見出しだけ**で、中身は書く人が選んで返す。
///
/// **番号の変数を ref で渡すのがいちばん短い。**押されるたびに、その変数が書き換わる。
///
/// ```
/// ui.tabs(ref page, ["メモ", "いろ"])       // page が直に書き換わる
/// ui.tabs("page", ["メモ", "いろ"], page)   // ui.show() が "page" を返す
/// ```
///
/// ```
/// ui.col([
///   ui.tabs("tab", ["せってい", "いろ"], tab),
///   page(),        // tab の中身は、いまの番号を見て自分で組む
/// ])
/// ```
///
/// 中身まで抱えないのは、「いまどうあるべきか」を返すという書き方に合わせるため。
/// 見出しと中身が別々なので、中身をどこに置くかも自由に決められる。
///
/// 引数:
///   index    いま開いているタブの番号（ref なら、書き換える先の変数）
///   labels   見出しの文字
///   id       名札（ref の代わりに渡す）
///
/// 例:
///   ui.open(200, 60);
///   var tab = 0;
///   _ = ui.show(ui.tabs(ref tab, ["あ", "い"]));
///   print(tab);   // 0
func tabs(id: string, labels: list<string>, index: int) -> Widget;
func tabs(action: func() -> void, labels: list<string>, index: int) -> Widget;
func tabs(ref index: int, labels: list<string>) -> Widget;

/// 縦に空ける。h は画素の数。
///
/// 例:
///   ui.open(80, 60);
///   _ = ui.show(ui.col([ui.label("上"), ui.space(20), ui.label("下")]));
///   print(ui.height());   // 60
func space(h: int) -> Widget;

/// スペーサー。空き場所を取る部品で、**並んでいる向き**に空ける。
///
/// ui.row の中なら横に、ui.col の中なら縦に場所を取る。
/// 数を省くと、**余ったところをぜんぶ取る**（伸びる空き）。
/// 横に並べたものを端に寄せたいときは、あいだに1つ置く。
///
/// ```
/// ui.row([ui.label("なまえ"), ui.spacer(), ui.button("消す", "del")])   // 右端へ
/// ui.row([ui.spacer(), ui.button("おわる", "end")])                     // 右に寄せる
/// ui.row([ui.spacer(), ui.label("まんなか"), ui.spacer()])              // 真ん中へ
/// ui.col([ui.label("上"), ui.spacer(), ui.label("下")])                 // 上と下へ
/// ```
///
/// 引数:
///   size   空ける画素の数。省くと、余りをぜんぶ取る
///
/// 注意:
///   ui.space(h) は**縦にしか**空けない。横に並べたときにも効かせたいときは、こちら。
///   伸びる空きを2つ以上置くと、余りを等分する。
///
/// 例:
///   ui.open(120, 40);
///   var red = ui.rgb(255, 0, 0);
///   _ = ui.show(ui.row([ui.label("a"), ui.spacer(), ui.label("b").background(red)]), 0, 0);
///   print(ui.get(119, 0));   // 16711680（右の端まで寄る）
func spacer() -> Widget;
func spacer(size: int) -> Widget;

/// 中身を縦に並べる部品。
///
/// 部品を並べるいちばんふつうの入れ物で、view() が返す1つは、たいていこれになる。
/// 横並び（ui.row）の中に縦の並びを入れるのにも使う。
///
/// 大きさは**中身に合わせて伸び縮みする**。幅はいちばん広い子、高さは子の合計
/// （ui.row はその逆）。だから .background() も中身のぶんだけ塗られる。
/// 広げたいときは、取り分（.width(1.0) など）か画素（.width(n)）を書く。
/// 中の部品に書いた取り分も、入れ物ごしに効く（下の width / height）。
///
/// **いちばん外（ui.show に渡した部品）だけ**は、寄せていなければ置ける幅
/// いっぱいに広がる。だからいちばん外の並びでは、区切り線（ui.divider）や
/// 寄せ（.align）が面の幅を見る。ui.row も ui.grid も同じ。
///
/// 例:
///   ui.open(120, 60);
///   _ = ui.show(ui.row([
///     ui.col([ui.label("左上"), ui.label("左下")]),
///     ui.col([ui.label("右上"), ui.label("右下")]),
///   ]));
///   print(ui.get(5, 4) != 0);   // true
func col(children: list<Widget>) -> Widget;

/// 中身を横に並べる部品。
///
/// 例:
///   ui.open(160, 40);
///   _ = ui.show(ui.row([ui.button("はい", "yes"), ui.button("いいえ", "no")]));
///   print(ui.width());   // 160
func row(children: list<Widget>) -> Widget;

/// グリッド（格子・表）。cols 列に、左上から右へ、いっぱいになれば次の行へと升を詰める。
///
/// 列の幅はその列でいちばん広い升、行の高さはその行でいちばん高い升に揃う。
/// だから升の大きさがまちまちでも、縦の線が通る。升の数が列の数で割り切れなくても
/// よい（最後の行が途中で終わる）。
///
/// 升に取り分（`.width(1.0)` など）を書くと、その列（行）の取り分になり、
/// 余りを分け合う。
///
/// **升ごとの関数から作る形**もある。cell(行, 列) が返す部品を、同じ順に詰める。
/// 行も列も 0 から数える。
///
/// 引数:
///   cols    列の数（1 以上）
///   cells   升に入れる部品。左上から右へ
///   rows    行の数（関数から作る形）
///   cell    升を作る関数。行と列を受け取る
///
/// 例:
///   ui.open(100, 60);
///   var red = ui.rgb(255, 0, 0);
///   var blue = ui.rgb(0, 0, 255);
///   _ = ui.show(ui.grid(2, [ui.label("a").background(red), ui.label("b").background(blue),
///                           ui.label("ccc").background(red), ui.label("d").background(blue)]), 0, 0);
///   var w = ui.text_width("ccc");                  // 左の列は "ccc" の幅に揃う
///   print(f"{ui.get(0, 0)} {ui.get(w + 11, 3)}");   // 16711680 255
///
///   func cell(r: int, c: int) -> Widget { return ui.button(f"{r},{c}", f"{r}-{c}"); }
///   ui.clear(0);
///   _ = ui.show(ui.grid(3, 3, cell));
///   print(f"{ui.get(5, 5) != 0} {ui.get(5, 59) != 0}");   // true false
func grid(cols: int, cells: list<Widget>) -> Widget;
func grid(rows: int, cols: int, cell: func(int, int) -> Widget) -> Widget;

/// 中身をまとめて、置ける幅の真ん中に置く。
///
/// `ui.col(中身).align("center")` と同じ。中身どうしの並びは変わらない。
///
/// 例:
///   ui.open(120, 40);
///   _ = ui.show(ui.center([ui.label("まんなか")]), 0, 0);
///   print(ui.width());   // 120
func center(children: list<Widget>) -> Widget;

/// 中身を**同じところに重ねて**置く（重ね置き・ZStack）。
///
/// 書いた順に重なり、あとのものが上に来る。大きさはいちばん大きい中身に合わせる。
/// 絵の上に字を出す、下地の上にボタンを置く、といったときに使う。
///
/// 中身の置き場所は、それぞれの `.align`（横）と `.valign`（縦）で決める。
/// 書かなければ左上に置く。
///
/// 例:
///   ui.open(80, 40);
///   _ = ui.show(ui.stack([
///     ui.label("").width(40).height(20).background(ui.rgb(0, 0, 255)),
///     ui.label("x").align("center").valign("middle"),
///   ]), 0, 0);
///   print(ui.get(0, 0));   // 255
func stack(children: list<Widget>) -> Widget;

/// 巻物（スクロールできる入れ物）。中身は縦に並び、はみ出したぶんは送って見る。
///
/// **高さを決める**（`.height(n)` か取り分）と、そこに入りきらないぶんが
/// 隠れて、右に帯が出る。帯はつまんで動かせるほか、上に載せて車輪（ホイール）でも送れる。
/// 高さを決めなければ、中身のぶんだけ伸びて巻かれない。
///
/// 隠れているところは押されない。送ったところは覚えていて、次の回も同じところが出る。
/// 名札を渡しておくと、置き場所が動いても同じ巻物として覚える。
///
/// 引数:
///   id        巻いたところを覚えるための名札（省ける）
///   children  中に縦に並べる部品
///
/// 例:
///   ui.open(80, 60);
///   var rows: list<Widget> = [];
///   for var i in range(20) { rows.push(ui.label(f"{i} 行目")); }
///   _ = ui.show(ui.scroll(rows).height(40), 0, 0);
///   print(ui.get(0, 50) != 0);   // false
func scroll(children: list<Widget>) -> Widget;
func scroll(id: string, children: list<Widget>) -> Widget;

/// セパレータ（区切り線）。置ける幅いっぱいに引く。
///
/// 例:
///   ui.open(80, 40);
///   _ = ui.show(ui.col([ui.label("上"), ui.divider(), ui.label("下")]), 0, 0);
///   print(f"{ui.get(0, 14) != 0} {ui.get(79, 14) != 0}");   // true true
func divider() -> Widget;

/// 部品を描いて、押されたものの名札を返す。
///
/// 渡すのは部品1つ。いくつも並べるときは ui.col / ui.row / ui.grid に入れて1つにする。
/// 誰も押していなければ空の文字。値を持つ部品（checkbox、slider、field）なら、
/// 新しい値は ui.value() か ui.text_value() で取れる。
///
/// 部品は毎回この場で作り直す。処理系は部品の状態を覚えないので、
/// **「いまどうあるべきか」だけを書けばよい**。
///
/// 置く場所は左上から (4, 4)。x と y を渡すとそこに置く。
///
/// 引数:
///   view    部品
///   x, y    置く場所（省くと 4, 4）
///
/// 例:
///   ui.open(120, 60);
///   var count = 0;
///   var hit = ui.show(ui.col([ui.label(f"{count} 回"), ui.button("ふやす", "inc")]));
///   if hit == "inc" { count += 1; }
///   print(count);   // 0
func show(view: Widget) -> string;
func show(view: Widget, x: int, y: int) -> string;

/// 直前の ui.show() で、ref で渡した変数が書き換わったか。
///
/// ui.field(ref ...) に文字が打たれると true になる。ui.run() が中で使っていて、
/// 変わっていればその場で描き直す。自分でくり返しを書くときも同じようにする。
///
/// 例:
///   ui.open(140, 40);
///   var name = "さめ";
///   _ = ui.show(ui.field(ref name));
///   print(ui.edited());   // false（何も打たれていない）
func edited() -> bool;

/// この回、**関数を持った部品**が押されたか。
///
/// ui.run() が中で使っている。自分でくり返しを書くときは、これで見て ui.action() を呼ぶ。
///
/// 例:
///   ui.open(80, 40);
///   _ = ui.poll();
///   print(ui.has_action());   // false
func has_action() -> bool;

/// 押された部品が持っていた関数。持っていなければ、何もしない関数。
///
/// 注意:
///   関数の値は、**変数に入れてから呼ぶ**。その変数は関数の中に置く
///   （トップレベルの変数からは呼べない）。
///
/// 例:
///   func once() -> void {
///     if ui.has_action() {
///       var act = ui.action();
///       act();
///     }
///   }
///   ui.open(80, 40);
///   _ = ui.poll();
///   once();
///   print(ui.width());   // 80
func action() -> func() -> void;

/// 直前の ui.show() で動いた部品の、新しい数。
///
/// checkbox なら 1 か 0、slider なら選ばれた数。
///
/// 例:
///   ui.open(120, 40);
///   var vol = 30;
///   if ui.show(ui.slider("vol", vol, 0, 100)) == "vol" { vol = ui.value(); }
///   print(vol);   // 30
func value() -> int;

/// 直前の ui.show() で動いた入力欄の、新しい文字。
///
/// 例:
///   ui.open(140, 40);
///   var name = "";
///   if ui.show(ui.field("name", name)) == "name" { name = ui.text_value(); }
///   print(f"[{name}]");   // []
func text_value() -> string;

/// 部品の色を決める。
///
/// 3色だけ決めれば、部品の色はそこから作られる。
///
/// 引数:
///   bg       下地の色（部品の中の塗りに使う）
///   fg       文字の色
///   accent   縁と、選ばれているところの色
///
/// 例:
///   ui.open(80, 40);
///   ui.theme(ui.rgb(20, 20, 28), ui.rgb(230, 230, 230), ui.rgb(76, 155, 232));
///   _ = ui.show(ui.button("押す", "go"));
///   print(ui.get(5, 5) != 0);   // true
func theme(bg: int, fg: int, accent: int) -> void;


// ------------------------------------------------------------ 部品の見た目

/// 絵（画素の面）。ui.canvas() か ui.load_png() で作る。
///
/// **ふつうの値**なので、代入すればコピーになる。中身は書き換えるまで写さないので、
/// 「直す前に控えを取る」が安く書ける。
///
/// 描くメソッドは画面に描く ui.* と同じ名前・同じ引数で、描き先だけが違う。
/// 切り抜き（clip）は絵ごとに覚えている。
///
/// 例:
///   var e = ui.canvas(8, 8, ui.rgb(0, 0, 255));
///   var keep = e;                   // ここでは写さない
///   e.clear(ui.rgb(255, 0, 0));     // ここで写る
///   print(f"{keep.get(0, 0)} {e.get(0, 0)}");   // 255 16711680
class Canvas {
  /// 横の画素数。
  ///
  /// 例:
  ///   print(ui.canvas(12, 5).width());   // 12
  func width() -> int;

  /// 縦の画素数。
  ///
  /// 例:
  ///   print(ui.canvas(12, 5).height());   // 5
  func height() -> int;

  /// 点の色を読む。外を尋ねたら 0。
  ///
  /// 例:
  ///   var e = ui.canvas(4, 4, ui.rgb(0, 255, 0));
  ///   print(e.get(1, 1));   // 65280
  func get(x: int, y: int) -> int;

  /// 点を打つ。半透明の色なら、下にある色と混ざる。
  ///
  /// 絵を直す道具の「筆」は、これ1つで書ける。
  /// ui.rgba(0, 0, 0, 0) を打てば「消しゴム」になる。
  ///
  /// 例:
  ///   var e = ui.canvas(4, 4, ui.rgb(0, 0, 255));
  ///   e.set(1, 1, ui.rgba(0, 0, 0, 0));   // 消す
  ///   print(ui.alpha(e.get(1, 1)));       // 0
  func set(x: int, y: int, color: int) -> void;

  /// ぜんぶ1色で塗る。切り抜きの中だけを塗る。
  ///
  /// 例:
  ///   var e = ui.canvas(4, 4);
  ///   e.clear(ui.rgb(255, 0, 0));
  ///   print(e.get(2, 2));   // 16711680
  func clear(color: int) -> void;

  /// 横の線。
  ///
  /// 例:
  ///   var e = ui.canvas(8, 8, ui.rgb(0, 0, 0));
  ///   e.hline(1, 2, 4, ui.rgb(255, 0, 0));
  ///   print(f"{e.get(1, 2)} {e.get(5, 2)}");   // 16711680 0
  func hline(x: int, y: int, w: int, color: int) -> void;

  /// 縦の線。
  ///
  /// 例:
  ///   var e = ui.canvas(8, 8, ui.rgb(0, 0, 0));
  ///   e.vline(2, 1, 4, ui.rgb(255, 0, 0));
  ///   print(f"{e.get(2, 1)} {e.get(2, 5)}");   // 16711680 0
  func vline(x: int, y: int, h: int, color: int) -> void;

  /// 2点をつなぐ線。
  ///
  /// 例:
  ///   var e = ui.canvas(8, 8);
  ///   e.line(0, 0, 7, 7, ui.rgb(255, 0, 0));
  ///   print(e.get(3, 3));   // 16711680
  func line(x0: int, y0: int, x1: int, y1: int, color: int) -> void;

  /// 四角の枠。
  ///
  /// 例:
  ///   var e = ui.canvas(8, 8, ui.rgb(0, 0, 0));
  ///   e.rect(1, 1, 4, 4, ui.rgb(255, 0, 0));
  ///   print(f"{e.get(1, 1)} {e.get(2, 2)}");   // 16711680 0
  func rect(x: int, y: int, w: int, h: int, color: int) -> void;

  /// 中まで塗った四角。
  ///
  /// 例:
  ///   var e = ui.canvas(8, 8);
  ///   e.fill_rect(1, 1, 4, 4, ui.rgb(255, 0, 0));
  ///   print(e.get(2, 2));   // 16711680
  func fill_rect(x: int, y: int, w: int, h: int, color: int) -> void;

  /// 円の枠。
  ///
  /// 例:
  ///   var e = ui.canvas(9, 9, ui.rgb(0, 0, 0));
  ///   e.circle(4, 4, 3, ui.rgb(255, 0, 0));
  ///   print(f"{e.get(4, 1)} {e.get(4, 4)}");   // 16711680 0
  func circle(x: int, y: int, r: int, color: int) -> void;

  /// 中まで塗った円。
  ///
  /// 例:
  ///   var e = ui.canvas(9, 9);
  ///   e.fill_circle(4, 4, 3, ui.rgb(255, 0, 0));
  ///   print(e.get(4, 4));   // 16711680
  func fill_circle(x: int, y: int, r: int, color: int) -> void;

  /// 画素の並びをそのまま置く。並べ方は ui.blit と同じ。
  ///
  /// 例:
  ///   var e = ui.canvas(4, 4);
  ///   e.blit(1, 1, 2, [ui.rgb(255, 0, 0), ui.rgb(0, 255, 0),
  ///                    ui.rgb(0, 0, 255), ui.rgb(255, 255, 255)]);
  ///   print(e.get(2, 2));   // 16777215
  func blit(x: int, y: int, w: int, pixels: list<int>) -> void;

  /// 文字を描く。字形は画面と同じもの（ui.font で決まる）。
  ///
  /// 例:
  ///   ui.font_builtin();
  ///   var e = ui.canvas(40, 12);
  ///   e.text(1, 1, "Hi", ui.rgb(255, 255, 255));
  ///   print(e.get(1, 1));   // 16777215
  func text(x: int, y: int, s: string, color: int) -> void;
  func text(x: int, y: int, s: string, color: int, scale: int) -> void;

  /// 別の絵を、この絵に貼る。透けているところは下が残る。
  ///
  /// 大きさを渡すと伸び縮みする（ui.draw と同じ）。
  ///
  /// 例:
  ///   var a = ui.canvas(8, 8);
  ///   var b = ui.canvas(2, 2, ui.rgb(0, 255, 0));
  ///   a.draw(b, 1, 1);
  ///   print(a.get(2, 2));   // 65280
  func draw(image: Canvas, x: int, y: int) -> void;
  func draw(image: Canvas, x: int, y: int, w: int, h: int) -> void;

  /// 三角形を塗る。ui.tri と同じで、描き先がこの絵になる。
  ///
  /// 奥行き（ui.depth）は、画面と同じ1枚を使う。
  ///
  /// 例:
  ///   var e = ui.canvas(8, 8, ui.rgb(0, 0, 0));
  ///   e.tri(0, 0, 0, 7, 0, 0, 0, 7, 0, ui.rgb(255, 0, 0));
  ///   print(f"{e.get(1, 1)} {e.get(6, 6)}");   // 16711680 0
  func tri(x0: int, y0: int, z0: int, x1: int, y1: int, z1: int, x2: int, y2: int, z2: int, color: int) -> void;

  /// ここから外には描かない。絵ごとに覚えている。
  ///
  /// 例:
  ///   var e = ui.canvas(8, 8, ui.rgb(0, 0, 0));
  ///   e.clip(0, 0, 4, 4);
  ///   e.clear(ui.rgb(255, 0, 0));
  ///   print(f"{e.get(2, 2)} {e.get(6, 6)}");   // 16711680 0
  func clip(x: int, y: int, w: int, h: int) -> void;

  /// 切り抜きをやめて、絵いっぱいに戻す。
  ///
  /// 例:
  ///   var e = ui.canvas(8, 8);
  ///   e.clip(0, 0, 4, 4);
  ///   e.clip_off();
  ///   e.clear(ui.rgb(255, 0, 0));
  ///   print(e.get(6, 6));   // 16711680
  func clip_off() -> void;

  /// この絵を PNG にして返す。
  ///
  /// 透けているところが1つでもあれば透明つきで、なければ赤緑青だけで書く。
  /// ui.load_png() で読み戻せる。
  ///
  /// 例:
  ///   var e = ui.canvas(4, 4, ui.rgb(255, 0, 0));
  ///   var png = e.to_png();
  ///   print(png.to_hex().starts_with("89504e47"));   // true
  func to_png() -> bytes;
}

/// 画面に出す部品。ui.label() などで作り、ui.col / ui.row / ui.grid で組んで ui.show() に渡す。
///
/// 見た目を変えるメソッドは、**変えたものを返す**（元は変わらない）。
/// だから鎖のようにつないで書ける。
///
/// 例:
///   ui.open(120, 60);
///   var w = ui.label("さめ").color(ui.rgb(255, 200, 0)).padding(4);
///   _ = ui.show(w, 0, 0);
///   print(ui.width());   // 120
class Widget {
  /// 文字の色を変える。
  ///
  /// 例:
  ///   ui.open(80, 40);
  ///   _ = ui.show(ui.label("l").color(ui.rgb(255, 0, 0)), 0, 0);
  ///   print(ui.get(1, 0));   // 16711680
  func color(c: int) -> Widget;

  /// 下地の色を変える。部品の後ろを塗る。
  ///
  /// 例:
  ///   ui.open(80, 40);
  ///   _ = ui.show(ui.label("l").background(ui.rgb(0, 0, 255)), 0, 0);
  ///   print(ui.get(0, 0));   // 255
  func background(c: int) -> Widget;

  /// 内側の余白（画素）。部品の周りに空きを作る。
  ///
  /// 例:
  ///   ui.open(80, 40);
  ///   _ = ui.show(ui.label("l").padding(4).background(ui.rgb(0, 0, 255)), 0, 0);
  ///   print(ui.get(0, 0));   // 255
  func padding(n: int) -> Widget;

  /// 幅を決める。**int なら画素、float なら取り分**（fr）。
  ///
  /// 決めなければ中身から決まる。取り分は、横に並んだ仲間との比。
  /// 大きさの決まっている部品を除いた**余り**を、書いた数の比で分け合う。
  /// `float.infinity()` は「余りぜんぶ」。
  ///
  /// 縦に並んでいる部品に取り分を書くと、置ける幅いっぱいになる。
  ///
  /// 例:
  ///   ui.open(80, 40);
  ///   _ = ui.show(ui.label("l").width(50).background(ui.rgb(0, 255, 0)), 0, 0);
  ///   print(f"{ui.get(49, 0) != 0} {ui.get(50, 0) != 0}");   // true false
  ///   ui.clear(0);
  ///   // 幅 80 を 1:1 で分ける（間は 6 画素）
  ///   _ = ui.show(ui.row([ui.label("a").width(1.0).background(ui.rgb(255, 0, 0)),
  ///                       ui.label("b").width(1.0).background(ui.rgb(0, 0, 255))]), 0, 0);
  ///   print(f"{ui.get(36, 0)} {ui.get(79, 0)}");   // 16711680 255
  func width(n: int) -> Widget;
  func width(fr: float) -> Widget;

  /// 高さを決める。**int なら画素、float なら取り分**（fr）。
  ///
  /// 取り分の分け方は width と同じで、こちらは縦に並んだ仲間との比。
  /// 横に並んでいる部品に書くと、その並びの高さいっぱいになる。
  ///
  /// 取り分は**親がくれた場所の余り**を分けるもの。入れ物（ui.row / ui.col / ui.grid）が
  /// その向きの大きさを決めていなければ、中の部品の取り分は**入れ物ごしに外まで効く**。
  /// だから row の中のボタンに書くだけで、その row が col の余りを取り、ボタンが下まで伸びる。
  /// 入れ物に画素の大きさ（.height(n)）か入れ物自身の取り分を書くと、そちらが勝つ。
  ///
  /// ```
  /// ui.col([
  ///   ui.label("上"),
  ///   ui.row([ui.button("a", "a"),
  ///           ui.button("b", "b").height(float.infinity())]),   // ← row も一緒に、余りまで広がる
  /// ])
  /// ```
  ///
  /// 例:
  ///   ui.open(80, 40);
  ///   _ = ui.show(ui.label("l").height(20).background(ui.rgb(0, 255, 0)), 0, 0);
  ///   print(f"{ui.get(0, 19) != 0} {ui.get(0, 20) != 0}");   // true false
  ///   ui.clear(0);
  ///   // 高さ 40 を 1:1 で分ける（間は 4 画素）
  ///   _ = ui.show(ui.col([ui.label("a").width(1.0).height(1.0).background(ui.rgb(255, 0, 0)),
  ///                       ui.label("b").width(1.0).height(1.0).background(ui.rgb(0, 0, 255))]), 0, 0);
  ///   print(f"{ui.get(0, 17)} {ui.get(0, 39)}");   // 16711680 255
  ///   ui.clear(0);
  ///   // row の中の b に書くだけで、row が col の余りを取り、b が下まで伸びる
  ///   var b = ui.label("b").height(float.infinity()).background(ui.rgb(0, 0, 255));
  ///   _ = ui.show(ui.col([ui.label("a"), ui.row([ui.label("x"), b])]), 0, 0);
  ///   print(ui.get(12, 39));   // 255
  ///   ui.clear(0);
  ///   // 入れ物が大きさを決めていれば、そこで止まる（row は 12 のまま）
  ///   _ = ui.show(ui.col([ui.label("a"), ui.row([ui.label("x"), b]).height(12)]), 0, 0);
  ///   print(f"{ui.get(12, 23) != 0} {ui.get(12, 39)}");   // true 0
  func height(n: int) -> Widget;
  func height(fr: float) -> Widget;

  /// 親がくれた幅の中で、どこに寄せるか。`"left"` `"center"` `"right"`。
  ///
  /// 例:
  ///   ui.open(80, 40);
  ///   _ = ui.show(ui.label("l").align("right"), 0, 0);
  ///   print(ui.get(1, 1) != 0);   // false
  func align(a: string) -> Widget;

  /// 親がくれた高さの中で、縦にどこへ寄せるか。`"top"` `"middle"` `"bottom"`。
  ///
  /// 書かなければ、置く側の決めた既定になる（横並び・格子ではまんなか、
  /// 重ね置き（ui.stack）では上）。
  ///
  /// 例:
  ///   ui.open(80, 40);
  ///   _ = ui.show(ui.stack([ui.label("").width(40).height(30),
  ///                         ui.label("l").valign("bottom").color(ui.rgb(255, 0, 0))]), 0, 0);
  ///   print(ui.get(1, 1) != 0);   // false
  func valign(a: string) -> Widget;

  /// 縁（ボーダー）を引く。太さを省くと 1 画素。
  ///
  /// 中身の上から引くので、細い線でも隠れない。`.radius()` と一緒に書けば、
  /// 角の丸みに沿って曲がる。
  ///
  /// 例:
  ///   ui.open(80, 40);
  ///   _ = ui.show(ui.label("l").width(40).height(20).border(ui.rgb(255, 0, 0)), 0, 0);
  ///   print(f"{ui.get(0, 0)} {ui.get(20, 10)}");   // 16711680 0
  func border(c: int) -> Widget;
  func border(c: int, w: int) -> Widget;

  /// 角の丸み（画素）。下地（`.background`）と縁（`.border`）の両方に効く。
  ///
  /// 0 を渡すと四角に戻る。縦横の半分より大きい数を渡しても、そこで止まる。
  ///
  /// 例:
  ///   ui.open(80, 40);
  ///   _ = ui.show(ui.label("l").width(40).height(20).radius(8)
  ///                 .background(ui.rgb(0, 0, 255)), 0, 0);
  ///   print(f"{ui.get(0, 0)} {ui.get(20, 10)}");   // 0 255
  func radius(n: int) -> Widget;

  /// ツールチップ。カーソルを合わせたときに出す説明。
  ///
  /// どの部品にも付けられる。少しのあいだ合わせ続けると、カーソルのそばに出る
  /// （すぐ出すと、通りすがりで点滅して読みにくいため）。長い文は折り返す。
  ///
  /// 入れ子にしたときは、**細かいほう**（中身）の説明が出る。
  ///
  /// 例:
  ///   ui.open(120, 40);
  ///   _ = ui.show(ui.button("消す", "del").tooltip("押すと、ぜんぶ消えます"));
  ///   print(ui.width());   // 120
  func tooltip(text: string) -> Widget;

  /// プレースホルダ。何も入っていないときに、うすく出しておく字。
  ///
  /// 入力欄（ui.field / ui.textarea / ui.password / ui.number）で、
  /// **そこに何を入れるところか**を出しておくのに使う。1字でも打てば消える。
  ///
  /// 出しているだけなので、中身にはならない。ui.text_value() や ref で渡した変数は
  /// 空のまま。伏せ字の欄（ui.password）でも、この字は伏せない。
  ///
  /// 例:
  ///   ui.open(160, 40);
  ///   var name = "";
  ///   _ = ui.show(ui.field("name", name).placeholder("なまえ"));
  ///   print(f"[{name}]");   // []（うすい字は中身にならない）
  func placeholder(text: string) -> Widget;
}
